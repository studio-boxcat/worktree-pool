#!/usr/bin/env bash
# wt — dev-session wrapper around `worktree-pool`: acquire + launch a shell +
# safe-recycle on exit. See https://github.com/studio-boxcat/worktree-pool
#
# Usage:
#   wt [--pool <key>] init    [--max-slots <n>] [pool-init-flags...]   # default --max-slots 16
#   wt [--pool <key>] acquire <name> [--from <commit-ish>] [pool-acquire-flags...]   # acquire only, print path
#   wt [--pool <key>] go      <name> [--from <commit-ish>] [pool-acquire-flags...]
#   wt [--pool <key>] release [name] [--force]   # name defaults to cwd's slot
#   wt [--pool <key>] cleanup <name>     # 🟢/🟡/🔴 exit-trap classifier
#   wt [--pool <key>] path    <name>     # exit 0 if exists, 1 if not, 2 on error
#   wt [--pool <key>] ls      [--git-status]
#   wt [--pool <key>] info    <name>
#   wt land   [message]                  # commit dirty work + ff slot's commits onto local main (local-only; no push, no PR)
#   wt whoami                            # cwd context: worktree|source|none + path
#   wt orient                            # print current repo path + CLAUDE.md
#
# Pool root: $WORKTREE_ROOT (required — no fallback). Set in ~/.zshenv.local.
#
# Pool key auto-resolution (override with --pool):
#   1. cwd inside $WORKTREE_ROOT/<key>/<name>/...  → key derived from path
#   2. cwd inside a git repo whose toplevel matches some pool's `source:`
#   3. error if zero or multiple matches
#
# Hooks: `<source>/.wt-hooks.sh` is sourced before lifecycle verbs run; defines
# any of wt_pre_go / wt_pre_cleanup / wt_post_cleanup / wt_post_land (+ core's
# wt_post_acquire) and may set WT_LAUNCHER. Full contract (env, firers,
# WT_FRESH axes): [[wt.md#hooks-sourcewt-hookssh]].

set -uo pipefail   # set -e is per-subcommand (cleanup must always exit 0).

# Fresh-acquire launches returning in <N seconds are suspect (launcher never
# really started); warn before the EXIT trap recycles.
readonly LAUNCH_MISFIRE_SECS=3

# ---------- helpers ----------

die() { echo "${0##*/}: $*" >&2; exit 1; }

# Required, no fallback: a silent default would mis-locate state on hosts that
# put the pool elsewhere (external SSD, etc.).
[ -n "${WORKTREE_ROOT:-}" ] \
  || die "WORKTREE_ROOT is unset. Add 'export WORKTREE_ROOT=\"\$HOME/.worktree-pool\"' to ~/.zshenv.local (or equivalent) and reopen your shell."

require_arg() { [ -n "$2" ] || die "usage: $3"; }

# Read `source:` from a pool's config and expand `~`. Empty on failure.
pool_source_path() {
  local cfg="$WORKTREE_ROOT/$1/.meta/config.yaml"
  [ -f "$cfg" ] || return 1
  local src
  src=$(awk -F': *' '/^source:/ {print $2; exit}' "$cfg")
  [ -n "$src" ] || return 1
  printf '%s' "${src/#\~/$HOME}"
}

# Filter captured `worktree-pool ls` output ($1) to held data rows (col 2 ==
# "held", past the 2 header lines). Single source of the ls-column coupling.
held_data_rows() { printf '%s\n' "$1" | awk 'NR>2 && $2=="held"'; }

# Echo any in-progress git operation marker for the repo at $1; empty if clean.
in_progress_marker() {
  local git_dir
  git_dir=$(git -C "$1" rev-parse --git-dir 2>/dev/null || true)
  [ -z "$git_dir" ] && return 0
  local marker
  for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$git_dir/$marker" ]; then
      printf '%s' "$marker"
      return 0
    fi
  done
}

# If $1 has an in-progress git operation, print a recovery hint to stderr and
# return 1; return 0 when clean. Callers OR multiple paths' failures together.
report_in_progress() {
  local path=$1 marker
  marker=$(in_progress_marker "$path")
  [ -z "$marker" ] && return 0
  local hint
  case "$marker" in
    MERGE_HEAD)                hint="git -C $path merge --abort" ;;
    rebase-merge|rebase-apply) hint="git -C $path rebase --abort" ;;
    CHERRY_PICK_HEAD)          hint="git -C $path cherry-pick --abort" ;;
    REVERT_HEAD)               hint="git -C $path revert --abort" ;;
    *)                         hint="finish or abort the in-progress operation in $path" ;;
  esac
  land_warn "in-progress $marker in $path — $hint"
  return 1
}

# Echo top-level submodule paths from `<repo>/.gitmodules`, one per line.
# Top-level only — `git submodule foreach` would recurse into nested.
submodule_paths() {
  git -C "$1" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{print $2}'
}

# Echo count of commits in <branch> not in main; '?' on rev-list failure.
# Returns 1 if the branch ref doesn't exist.
ahead_count() {
  local path=$1 branch=$2
  git -C "$path" show-ref --quiet --verify "refs/heads/$branch" || return 1
  git -C "$path" rev-list --count "main..$branch" 2>/dev/null || echo '?'
}

# True iff <slot-path>/.git exists AND resolves. The existence prefix stops
# git's upward-walk on a missing gitlink from passing by accident (e.g. a
# $HOME/.git for dotfiles).
slot_repo_ok() {
  [ -e "$1/.git" ] && git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

# Resolve a HELD slot's canonical path by branch name OR by canonical slot id
# (exit 0 + path when held; exit 1 when not). Two-step so operators can use
# either identity. The id fallback requires HEAD on a branch (held) so
# `wt go ios-0` against an idle canonical dir doesn't mis-resume.
slot_path_for() {
  local name=$1 path
  if path=$(worktree-pool --pool "$POOL_KEY" path --lease "$name" 2>/dev/null) && [ -n "$path" ]; then
    printf '%s\n' "$path"
    return 0
  fi
  path="$POOL_ROOT/$name"
  [ -d "$path" ] || return 1
  # Held = HEAD is on a branch (symbolic-ref succeeds).
  git -C "$path" symbolic-ref --quiet HEAD >/dev/null 2>&1 || return 1
  printf '%s\n' "$path"
}

# `land`-prefixed stderr (non-fatal) and fatal helpers.
land_warn() { printf 'land: %s\n' "$*" >&2; }
land_die()  { printf 'land: %s\n' "$*" >&2; exit 1; }

# Suppress user-repo merge/post-checkout hooks during land's mechanical
# fast-forwards (see [[wt.md#land-flow]] step 12; `wt_post_land` is the
# documented extension point).
git_no_hooks() { git -c core.hooksPath=/dev/null "$@"; }


# Populate <main_path>'s clone of a newly-introduced top-level submodule <sub>
# from the SLOT's clone — local, no network (see [[land-submodules.md]]).
# Mirrors acquire's two-phase config-write→update (src/submodules.rs): override
# the URL to the slot clone for the clone, then restore the declared URL so
# origin survives slot recycling. Must run AFTER the parent ff. Returns
# non-zero on failure; caller warns (non-fatal).
_land_clone_sub_from_slot() {
  local main_path=$1 slot_path=$2 sub=$3 declared
  [ -e "$slot_path/$sub/.git" ] || return 1   # slot has nothing to clone from
  declared=$(git -C "$main_path" config -f .gitmodules --get "submodule.$sub.url" 2>/dev/null) || declared=""
  git -C "$main_path" submodule init -- "$sub" >/dev/null 2>&1 || return 1
  git -C "$main_path" config "submodule.$sub.url" "$slot_path/$sub" || return 1
  git -C "$main_path" -c protocol.file.allow=always submodule update -- "$sub" || return 1
  if [ -n "$declared" ]; then
    git -C "$main_path" config "submodule.$sub.url" "$declared" || return 1
    git -C "$main_path/$sub" remote set-url origin "$declared" 2>/dev/null || true
  fi
  return 0
}

# True iff cwd is somewhere under $1 (symlinks resolved on both sides).
# Returns 1 if $1 doesn't exist — caller decides refuse vs pass.
inside_dir() {
  [ -d "$1" ] || return 1
  local cwd_real root_real
  cwd_real=$(pwd -P)
  root_real=$(cd "$1" && pwd -P)
  [[ "$cwd_real" == "$root_real"/* ]]
}

# Echo the canonical path of the slot cwd sits in ($POOL_ROOT/<slot-id>), or
# return 1 if cwd isn't inside a slot of this pool. Requires POOL_ROOT set.
# `inside_dir` guarantees cwd is strictly below the pool root, so the first
# path component is a slot dir (caller validates via slot_repo_ok).
slot_path_from_cwd() {
  inside_dir "$POOL_ROOT" || return 1
  local cwd_real pool_root_real rel
  cwd_real=$(pwd -P)
  pool_root_real=$(cd "$POOL_ROOT" && pwd -P)
  rel="${cwd_real#"$pool_root_real"/}"
  printf '%s\n' "$pool_root_real/${rel%%/*}"
}

# Land lock: per-source mutex serializing `wt land` (see [[wt.md#land-flow]]
# step 5 for why + reclaim semantics). macOS ships no `flock(1)`, so this is a
# PID+mtime scheme: lockfile body = holder bash PID, acquire spins with
# PID-liveness + mtime-stale fallback.
# Stale threshold 5 min: a legit hold spans seconds; PID-liveness catches the
# common crash case (SIGHUP/SIGKILL/panic) immediately.
LAND_LOCK_STALE_SECS=300
LAND_LOCK_MAX_WAIT_S=60

_land_lock_path() {
  # `--git-common-dir` is relative to the worktree root on non-bare clones;
  # anchor on $1 so lands from different cwds resolve to the same lockfile.
  local common
  common=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) || common=".git"
  case "$common" in
    /*) ;;
    *)  common="$1/$common" ;;
  esac
  printf '%s/worktree-pool/land.lock' "$common"
}

_land_lock_age_secs() {
  stat -f %m "$1" 2>/dev/null \
    | awk -v now="$(date +%s)" '{print now - $1}' 2>/dev/null
}

land_lock_acquire() {
  local source_path=$1 lockfile waited=0 holder_pid age
  lockfile=$(_land_lock_path "$source_path")
  mkdir -p "$(dirname "$lockfile")"
  while true; do
    if ( set -o noclobber; printf '%s\n' "$$" > "$lockfile" ) 2>/dev/null; then
      LAND_LOCK_HELD=$lockfile
      return 0
    fi
    holder_pid=$(awk 'NR==1{print; exit}' "$lockfile" 2>/dev/null)
    if [ -n "$holder_pid" ] && ! kill -0 "$holder_pid" 2>/dev/null; then
      land_warn "reclaiming land.lock (holder pid $holder_pid no longer running)"
      rm -f "$lockfile"
      continue
    fi
    age=$(_land_lock_age_secs "$lockfile")
    if [ -n "$age" ] && [ "$age" -ge "$LAND_LOCK_STALE_SECS" ]; then
      land_warn "reclaiming stale land.lock (age ${age}s ≥ ${LAND_LOCK_STALE_SECS}s)"
      rm -f "$lockfile"
      continue
    fi
    if [ "$waited" -ge "$LAND_LOCK_MAX_WAIT_S" ]; then
      land_die "land.lock held by pid ${holder_pid:-?} at $lockfile for >${LAND_LOCK_MAX_WAIT_S}s — another land in progress"
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

# Refuses to delete if the holder PID isn't ours — guards against stomping a
# successor that reclaimed our lock after a PID-liveness false positive.
land_lock_release() {
  [ -n "${LAND_LOCK_HELD:-}" ] || return 0
  local holder
  holder=$(awk 'NR==1{print; exit}' "$LAND_LOCK_HELD" 2>/dev/null)
  if [ "$holder" = "$$" ]; then
    rm -f "$LAND_LOCK_HELD"
  fi
  LAND_LOCK_HELD=""
}

# Echo the absolute path of the worktree with refs/heads/main checked out,
# empty if none. Slots are `git worktree`s of source, so from any slot this
# returns the source path.
find_main_path() {
  git worktree list --porcelain | awk '
    /^worktree /{p=substr($0, 10)}
    /^branch refs\/heads\/main$/{print p; exit}
  '
}

# Echo the key of each initialized pool whose `source:` repo canonicalizes to
# $1 (an absolute, resolved git toplevel), one per line. Empty if none match.
pool_keys_for_toplevel() {
  local toplevel=$1 cfg key src
  for cfg in "$WORKTREE_ROOT"/*/.meta/config.yaml; do
    [ -f "$cfg" ] || continue
    key=$(basename "$(dirname "$(dirname "$cfg")")")
    src=$(pool_source_path "$key") || continue
    src=$(cd "$src" 2>/dev/null && pwd -P) || continue
    [ "$src" = "$toplevel" ] && printf '%s\n' "$key"
  done
}

auto_pool_key() {
  local cwd_real
  cwd_real=$(pwd -P)

  if [ -d "$WORKTREE_ROOT" ]; then
    local pool_root_real
    pool_root_real=$(cd "$WORKTREE_ROOT" && pwd -P)
    if [[ "$cwd_real" == "$pool_root_real"/* ]]; then
      local rel="${cwd_real#$pool_root_real/}"
      printf '%s' "${rel%%/*}"
      return 0
    fi
  fi

  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  toplevel=$(cd "$toplevel" && pwd -P)

  local matches=() key
  while IFS= read -r key; do
    [ -n "$key" ] && matches+=("$key")
  done < <(pool_keys_for_toplevel "$toplevel")

  case ${#matches[@]} in
    0) return 1 ;;
    1) printf '%s' "${matches[0]}"; return 0 ;;
    *) echo "wt: cwd matches multiple pools (${matches[*]}) — pass --pool <key>" >&2; return 2 ;;
  esac
}

# Globals set by require_pool: POOL_KEY POOL_ROOT POOL_SOURCE
require_pool() {
  if [ -z "${POOL_KEY:-}" ]; then
    POOL_KEY=$(auto_pool_key) || die "could not infer --pool from cwd. \
Run from inside a pool's source repo or a slot, or pass --pool <key>."
  fi
  POOL_ROOT="$WORKTREE_ROOT/$POOL_KEY"
  [ -d "$POOL_ROOT" ] || die "pool '$POOL_KEY' not initialized at $POOL_ROOT — \
from inside the source repo, run: wt init [--max-slots <n>] [--groups ...]"
}

# Lazily resolve+cache `source:` so verbs that don't need it (ls, info, path)
# skip the awk fork.
pool_source() {
  [ -n "${POOL_SOURCE:-}" ] && { printf '%s' "$POOL_SOURCE"; return 0; }
  POOL_SOURCE=$(pool_source_path "$POOL_KEY") || die "pool '$POOL_KEY' has no source: in config.yaml"
  printf '%s' "$POOL_SOURCE"
}

# Source <hooks-base>/.wt-hooks.sh if present. Defaults to the pool source repo.
source_hooks() {
  local base="${1:-$(pool_source)}"
  local hooks_file="$base/.wt-hooks.sh"
  if [ -f "$hooks_file" ]; then
    # shellcheck source=/dev/null
    source "$hooks_file"
  fi
}

# Call hook function $1 if defined, passing remaining args. Returns 0 when
# absent so callers under `set -e` aren't aborted (a bare `declare -F … && fn`
# would propagate declare's non-zero return).
call_hook() {
  local fn="$1"; shift
  if declare -F "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  fi
}

# Export the WT_* env contract, source the hooks file, invoke the named hook.
# $name and $path come from the enclosing function's locals (dynamic scoping).
fire_hook() {
  local hook_name="$1" fresh="$2"
  export WT_KEY="$POOL_KEY" WT_LEASE="$name" WT_PATH="$path" WT_FRESH="$fresh"
  source_hooks
  call_hook "$hook_name"
}

# ---------- subcommands ----------

# Print the absolute slot path (resolution via slot_path_for). Exit:
#   0 — held slot found at the printed path
#   1 — no held slot matches NAME (printed path is a literal canonical-id guess)
#   2 — usage error or pool not initialized
cmd_path() {
  local name="${1:-}"; shift || true
  if [ -z "$name" ]; then
    echo "usage: ${0##*/} path <name>" >&2
    exit 2
  fi
  local path
  if path=$(slot_path_for "$name"); then
    printf '%s\n' "$path"
    return 0
  fi
  # Not held — emit a best-guess literal-canonical path for the caller.
  printf '%s\n' "$POOL_ROOT/$name"
  return 1
}

# Thin acquire: create a slot, print its path. No cd, no launcher, no trap.
cmd_acquire() {
  set -e
  local name="${1:-}"; shift || true
  [ -n "$name" ] || die "usage: wt acquire <name> [--from <commit-ish>] [pool-acquire-flags...]"

  # `--from <X>` → `--commit <X>`.
  local acquire_args=() from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)   [ $# -ge 2 ] || die "--from requires an argument"; from="$2"; shift 2 ;;
      --from=*) from="${1#--from=}"; shift ;;
      *)        acquire_args+=("$1"); shift ;;
    esac
  done
  [ -n "$from" ] && acquire_args=(--commit "$from" ${acquire_args[@]+"${acquire_args[@]}"})

  worktree-pool --pool "$POOL_KEY" acquire --lease "$name" ${acquire_args[@]+"${acquire_args[@]}"}
}

cmd_go() {
  set -e
  local name="${1:-}"; shift || true
  # Bare `wt go`: show held slots (what's in flight) then a usage warning.
  # Idle/fresh rows filtered out as noise.
  if [ -z "$name" ]; then
    local ls_out
    ls_out=$(worktree-pool --pool "$POOL_KEY" ls)
    local held_rows
    held_rows=$(held_data_rows "$ls_out")
    if [ -n "$held_rows" ]; then
      printf '%s\n' "$ls_out" | awk 'NR<=2'
      printf '%s\n' "$held_rows"
    else
      echo "(no held slots)"
    fi
    echo
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%swt go: name required.%s Pick an existing slot to resume, or a new name:\n  wt go <name> [--from <commit-ish>]\n' "$Y" "$X" >&2
    exit 2
  fi

  # `--from <X>` → `--commit <X>` for the underlying acquire.
  local acquire_args=() from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)     [ $# -ge 2 ] || die "--from requires an argument"; from="$2"; shift 2 ;;
      --from=*)   from="${1#--from=}"; shift ;;
      *)          acquire_args+=("$1"); shift ;;
    esac
  done
  # `${arr[@]+...}` keeps empty-array expansion safe under bash 3.2 `set -u`.
  [ -n "$from" ] && acquire_args=(--commit "$from" ${acquire_args[@]+"${acquire_args[@]}"})

  inside_dir "$POOL_ROOT" && die "refusing to nest — already inside a pool slot."

  # Non-TTY guard: the launcher needs an interactive terminal; without one it
  # exits in <1s, the EXIT trap fires, and a fresh+clean slot silently
  # 🟢-recycles. Refuse early. Override via `WT_GO_ALLOW_NOTTY=1` for CI
  # (rare; `worktree-pool acquire` is usually the right primitive).
  if [ -z "${WT_GO_ALLOW_NOTTY:-}" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    die "go: no TTY on stdin/stdout — launcher would misfire and the EXIT trap \
would silently recycle the slot.
  Common cause: running \`wt go\` from inside an existing AI session.
  For non-interactive automation use \`worktree-pool acquire\` directly, or set \
WT_GO_ALLOW_NOTTY=1."
  fi

  # Broken-dir guard: a canonical dir with a missing/dangling `.git` gitlink
  # (ghost slot — partial-cleanup debris). slot_path_for (needs HEAD on a
  # branch) would skip it and fall through to fresh-acquire, masking the debris.
  # Surface it loudly before deciding resume vs fresh.
  local literal_path="$POOL_ROOT/$name"
  if [ -d "$literal_path" ] && ! slot_repo_ok "$literal_path"; then
    die "slot '$name' at $literal_path is broken (no valid .git — likely partial-cleanup debris). \
Recover with: rm -rf $(printf '%q' "$literal_path"), then re-run."
  fi

  local path existing=0
  if path=$(slot_path_for "$name"); then
    existing=1
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ slot %s/%s already exists — resuming (acquire flags ignored). Use `%s release %s` first to recreate.%s\n' \
      "$Y" "$POOL_KEY" "$name" "${0##*/}" "$name" "$X" >&2
  else
    path=$(worktree-pool --pool "$POOL_KEY" acquire --lease "$name" ${acquire_args[@]+"${acquire_args[@]}"} | tail -1)
    if [[ -z "$path" || ! -d "$path" ]]; then
      die "pool returned no path."
    fi
  fi

  # EXIT trap → `wt _exit_handler`, which routes between the misfire-preserve
  # 🟡 path and the normal `wt cleanup` path. WT_FRESH/WT_LAUNCH_START start
  # empty and get real values just before the launcher exec; a failure before
  # that (e.g. crashed wt_pre_go) fires the trap with WT_FRESH empty → cleanup,
  # not preserve.
  export WT_KEY="$POOL_KEY" WT_LEASE="$name" WT_FRESH="" WT_LAUNCH_START=""
  trap "'$0' --pool \"\$WT_KEY\" _exit_handler \"\$WT_LEASE\"" EXIT

  printf '\n──── session: %s/%s @ %s ────\n\n' "$POOL_KEY" "$name" "$path"

  # Pre-launch hook. Non-zero exit aborts launch under set -e + fires EXIT trap.
  local fresh; fresh=$([ "$existing" = 0 ] && echo 1 || echo 0)
  fire_hook wt_pre_go "$fresh"

  # `-n <name>` sets claude's session display name. `--append-system-prompt`
  # warns subagents about the cross-worktree refs/stash race up front. Both
  # flags assume the launcher accepts them (true for `claude` / default `ai`).
  # printf %q quotes for the inline `zsh -ic` shell.
  local launcher="${WT_LAUNCHER:-ai}"
  local wt_prompt
  wt_prompt="You are inside a worktree-pool slot ($POOL_KEY/$name). Never run \`git stash\` here — \
the per-slot alias refuses it anyway because refs/stash is shared across worktrees of the same repo. \
For save/restore around tests use commit + soft-reset instead: \
\`git add -A && git commit -m wip ; ... ; git reset --soft HEAD^\`."
  local cmd
  printf -v cmd '%s -n %q --append-system-prompt %q' "$launcher" "$name" "$wt_prompt"
  [ "$existing" = 1 ] && cmd="$cmd --continue"

  # `set +e` around the subshell so a non-zero exit doesn't trip cmd_go's
  # `set -e` before the misfire warning below. WT_LAUNCH_START in the trap env
  # proves we reached the launcher; the handler reads it to compute launch_dur.
  export WT_FRESH="$fresh"
  export WT_LAUNCH_START=${EPOCHSECONDS:-$(date +%s)}
  set +e
  (cd "$path" && exec "${SHELL:-zsh}" -ic "$cmd")
  set -e
  local launch_dur=$(( ${EPOCHSECONDS:-$(date +%s)} - WT_LAUNCH_START ))

  if [ "$launch_dur" -lt "$LAUNCH_MISFIRE_SECS" ] && [ "$existing" = 0 ]; then
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ launcher (%s) exited after %ss — likely misfired (auth, env, missing TTY, or %s not on PATH).%s\n' \
      "$Y" "$launcher" "$launch_dur" "$launcher" "$X" >&2
  fi
}

# EXIT-trap target installed by `cmd_go`. Preserves the slot (🟡 misfire) or
# tail-calls cmd_cleanup. Always exits 0. Misfire-preserve fires only when ALL:
#   - WT_FRESH=1 (this acquire created the slot; resumes never recycle silently)
#   - launcher exited fast (dur < LAUNCH_MISFIRE_SECS)
#   - working tree clean, and no commits ahead of main
cmd__exit_handler() {
  local name="${1:-}"
  [ -n "$name" ] || exit 0

  local path
  if ! path=$(slot_path_for "$name") || ! slot_repo_ok "$path"; then
    # Slot gone or broken — defer to cleanup, which has the existing recovery messaging.
    exec "$0" --pool "$POOL_KEY" cleanup "$name"
  fi

  if [ "${WT_FRESH:-}" = "1" ]; then
    local now dur
    now=${EPOCHSECONDS:-$(date +%s)}
    # WT_FRESH=1 ⟹ WT_LAUNCH_START set; `:-0` only covers the impossible gap,
    # yielding a large dur → cleanup, never a false preserve.
    dur=$(( now - ${WT_LAUNCH_START:-0} ))

    local porcelain ahead
    porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
    ahead=0
    if a=$(ahead_count "$path" "$name"); then ahead="$a"; fi

    if [ "$dur" -lt "$LAUNCH_MISFIRE_SECS" ] \
       && [ -z "$porcelain" ] && [ "$ahead" = "0" ]; then
      local Y='' X=''
      [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
      printf '%s🟡 launcher misfire: slot %s/%s left in place (ran %ss < %ss, fresh acquire, tree clean).\n   Inspect: %s go %s   |   Discard: %s release --force %s%s\n' \
        "$Y" "$POOL_KEY" "$name" "$dur" "$LAUNCH_MISFIRE_SECS" \
        "${0##*/}" "$name" "${0##*/}" "$name" "$X" >&2
      exit 0
    fi
  fi

  exec "$0" --pool "$POOL_KEY" cleanup "$name"
}

# Land slot's commits onto local main: auto-commit dirty work, ff main → slot HEAD.
# Bidirectional submodule sync: slot→main (gating) and main→slot working tree
# (cosmetic). Local-only — never fetches origin, never pushes, never opens a PR.
# See [[docs/wt.md#land-flow]] for the authoritative, numbered step list.
cmd_land() {
  set -e
  local msg="${1:-}"

  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$branch" = "main" ] || [ "$branch" = "HEAD" ]; then
    land_die "must run from a non-main branch (current: $branch)"
  fi

  local marker
  marker=$(in_progress_marker .)
  if [ -n "$marker" ]; then
    land_warn "in-progress $marker — finish or abort first."
    echo "After finishing the merge commit, re-run land." >&2
    exit 1
  fi

  # No-op early exit: slot already landed (HEAD ≡ main) and tree clean. Skips
  # the land.lock + submodule preflight so a "did I land?" check never trips
  # refusals from unrelated in-progress state in main_path or its submodules.
  if [ -z "$msg" ] && git diff --quiet && git diff --cached --quiet \
      && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    local main_sha
    main_sha=$(git rev-parse main 2>/dev/null || true)
    if [ -n "$main_sha" ] && [ "$main_sha" = "$(git rev-parse HEAD)" ]; then
      echo "land: $branch already landed; main at $(git rev-parse --short HEAD)"
      exit 0
    fi
  fi

  # Clear a leftover git index.lock (crashed lazygit/git) before the auto-commit
  # — it would otherwise fail `git add`/`commit`. Unconditional remove, placed
  # AFTER the no-op early-exit so a read-only run never deletes a live lock.
  # WARNING: races a git process actively writing the index — accepted for
  # unattended lands.
  local index_lock
  index_lock=$(git rev-parse --git-path index.lock)
  if [ -e "$index_lock" ]; then
    land_warn "removing leftover git index.lock ($index_lock) — ensure no git/lazygit is mid-write in this slot"
    rm -f "$index_lock"
  fi

  local untracked
  untracked=$(git ls-files --others --exclude-standard)
  if [ -n "$untracked" ]; then
    land_warn "untracked files — add, ignore, or remove first:"
    printf '%s\n' "$untracked" | sed 's/^/  /' >&2
    exit 1
  fi

  local main_path slot_path
  main_path=$(find_main_path)
  [ -n "$main_path" ] || land_die "main is not checked out in any worktree"
  slot_path=$(git rev-parse --show-toplevel)

  # Acquire per-source land.lock before any check reading main_path's state.
  # EXIT trap releases on every exit path (SIGHUP/SIGKILL handled by the next
  # acquirer's PID-liveness reclaim).
  land_lock_acquire "$main_path"
  trap 'land_lock_release' EXIT

  # In-progress check on main worktree + its top-level submodules: the slot→main
  # advance and parent ff below write to these clones, and an unfinished
  # rebase/merge there surfaces as a confusing mid-flow failure. Skip nested and
  # the slot's own submodules (slot-side refresh is cosmetic best-effort).
  local main_marker_failed=0
  report_in_progress "$main_path" || main_marker_failed=1
  while IFS= read -r sub_path; do
    [ -n "$sub_path" ] || continue
    [ -e "$main_path/$sub_path/.git" ] || continue
    report_in_progress "$main_path/$sub_path" || main_marker_failed=1
  done < <(submodule_paths "$main_path")
  [ "$main_marker_failed" = 0 ] || exit 1

  # Tracked-uncommitted check only: the parent `merge --ff-only` refuses on
  # untracked-overwrite, and `--ignore-submodules=untracked` lets land proceed
  # alongside dirty submodule content. The `awk` drops `??` (untracked) rows.
  local main_dirty
  main_dirty=$(git -C "$main_path" status --porcelain --ignore-submodules=untracked | awk '!/^\?\?/')
  if [ -n "$main_dirty" ]; then
    land_warn "main worktree ($main_path) has uncommitted tracked changes:"
    printf '%s\n' "$main_dirty" | sed 's/^/  /' >&2
    exit 1
  fi

  # Auto-commit dirty tracked work. Refuse silent WIP commits.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    # Pre-stage submodule sync (see [[land-submodules.md#the-phases]]): a stale
    # post-merge working dir would be staged by `git add -u` as a gitlink
    # regression. Classify working HEAD vs index gitlink by ancestry:
    #   ==        → in sync, skip
    #   working < index → post-merge stale; `submodule update` brings it forward
    #   working > index → operator's pending forward bump; leave for auto-commit
    #   diverged  → refuse; operator resolves
    # `protocol.file.allow=always`: slot submodule clones use `file://` origins.
    local sub_sync_failed=0
    if [ -f "$slot_path/.gitmodules" ]; then
      local sub_path sub_index_sha sub_head_sha sub_full
      while IFS= read -r sub_path; do
        [ -n "$sub_path" ] || continue
        sub_full="$slot_path/$sub_path"
        [ -e "$sub_full/.git" ] || continue
        sub_index_sha=$(git -C "$slot_path" ls-files -s -- "$sub_path" 2>/dev/null \
          | awk '$1=="160000" && $3=="0" {print $2; exit}')
        [ -n "$sub_index_sha" ] || continue
        sub_head_sha=$(git -C "$sub_full" rev-parse HEAD 2>/dev/null) || continue
        [ "$sub_index_sha" = "$sub_head_sha" ] && continue
        # Ensure index SHA is reachable for the ancestry probe: `git merge`
        # updates the gitlink but doesn't fetch into the submodule clone, so the
        # new SHA may live only in main's submodule clone.
        if ! git -C "$sub_full" cat-file -e "${sub_index_sha}^{commit}" 2>/dev/null \
            && [ -e "$main_path/$sub_path/.git" ]; then
          git -C "$sub_full" fetch --quiet "$main_path/$sub_path" 2>/dev/null || true
        fi
        # Forward bump: leave for auto-commit. Behind: sync forward. Else: diverged.
        if git -C "$sub_full" merge-base --is-ancestor "$sub_index_sha" "$sub_head_sha" 2>/dev/null; then
          continue
        fi
        if git -C "$sub_full" merge-base --is-ancestor "$sub_head_sha" "$sub_index_sha" 2>/dev/null; then
          land_warn "submodule '$sub_path' working dir ${sub_head_sha:0:7} is behind recorded gitlink ${sub_index_sha:0:7} (post-merge without --recurse-submodules) — running submodule update"
          if ! git -C "$slot_path" -c protocol.file.allow=always \
               submodule update --quiet -- "$sub_path"; then
            land_warn "submodule update failed for '$sub_path' — fix manually and retry:"
            echo "  git -c protocol.file.allow=always submodule update -- $sub_path" >&2
            sub_sync_failed=1
          fi
          continue
        fi
        land_warn "submodule '$sub_path' diverged from recorded gitlink (working ${sub_head_sha:0:7} vs index ${sub_index_sha:0:7} share no ancestor) — refusing to auto-commit a regression."
        echo "  Resolve manually (e.g. git -c protocol.file.allow=always submodule update -- $sub_path), then re-run land." >&2
        sub_sync_failed=1
      done < <(submodule_paths "$slot_path")
    fi
    [ "$sub_sync_failed" = 0 ] || exit 1

    # Re-check dirty state — submodule sync above may have made the tree clean.
    if ! git diff --quiet || ! git diff --cached --quiet; then
      if [ -z "$msg" ]; then
        land_warn "dirty tracked work needs a commit message:"
        git status --short >&2
        echo >&2
        echo "  wt land \"feat: <what you did>\"" >&2
        echo "  wt land wip                        # shorthand → 'WIP via land'" >&2
        exit 1
      fi
      [ "$msg" = "wip" ] && msg="WIP via land"
      git add -u
      git commit -m "$msg"
    fi
  fi

  # Pre-merge main (for wt_post_land hook) and pre-merge slot HEAD (the
  # slot-direction submodule refresh below diffs against it to see what the
  # merge brought in from main's side; post-merge HEAD is the merge commit).
  local main_before slot_head_pre_merge
  main_before=$(git rev-parse main)
  slot_head_pre_merge=$(git rev-parse HEAD)

  # Merge main. Common case (no parallel land): no-op ("Already up to date.") —
  # slot's commits fast-forward main below. Only a parallel slot advancing main
  # yields a real 3-way merge (resume = re-run after manual commit).
  if ! git merge -m "Merge main into $branch" main; then
    echo >&2
    land_warn "merge halted with conflicts. Resolve and either:"
    echo "  • finish: 'git add' the files, 'git commit', then re-run land" >&2
    echo "  • back out: 'git merge --abort'" >&2
    exit 1
  fi

  # Refuse if a parallel slot's land advanced main past our merge base during
  # conflict resolution — `merge --ff-only` below would also catch this, but
  # this gives the operator a precise message.
  if ! git merge-base --is-ancestor main HEAD; then
    land_warn "main has moved past your merge base (parallel slot landed first)."
    echo "  Re-merge with 'git merge main', resolve, commit, then re-run." >&2
    exit 1
  fi

  # Reorder parents on the auto-generated merge so main stays first-parent on
  # mainline (slot-side `git merge main` puts slot tip first — inverted vs.
  # "merge feature into main"). Tree-identical rewrite preserving message +
  # author + committer identity. Skip no-ops and octopus merges (commit-tree
  # -p main -p slot would silently drop parents 3+).
  local post_merge_head
  post_merge_head=$(git rev-parse HEAD)
  if [ "$post_merge_head" != "$slot_head_pre_merge" ]; then
    local parent_count
    parent_count=$(git rev-list --parents -n1 HEAD | awk '{print NF-1}')
    if [ "$parent_count" = "2" ]; then
      local main_now orig_msg orig_author_name orig_author_email orig_author_date
      local orig_committer_name orig_committer_email orig_committer_date new_merge
      main_now=$(git rev-parse HEAD^2)
      orig_msg=$(git log -1 --format=%B HEAD)
      # Replace the inverted auto-generated message; keep operator-authored
      # resume messages verbatim.
      if [ "$(printf '%s' "$orig_msg" | head -1)" = "Merge main into $branch" ]; then
        orig_msg="Merge $branch into main"
      fi
      orig_author_name=$(git log -1 --format=%an HEAD)
      orig_author_email=$(git log -1 --format=%ae HEAD)
      orig_author_date=$(git log -1 --format=%aI HEAD)
      orig_committer_name=$(git log -1 --format=%cn HEAD)
      orig_committer_email=$(git log -1 --format=%ce HEAD)
      orig_committer_date=$(git log -1 --format=%cI HEAD)
      new_merge=$(GIT_AUTHOR_NAME="$orig_author_name" \
                  GIT_AUTHOR_EMAIL="$orig_author_email" \
                  GIT_AUTHOR_DATE="$orig_author_date" \
                  GIT_COMMITTER_NAME="$orig_committer_name" \
                  GIT_COMMITTER_EMAIL="$orig_committer_email" \
                  GIT_COMMITTER_DATE="$orig_committer_date" \
                  git commit-tree "$(git rev-parse HEAD^{tree})" \
                    -p "$main_now" -p "$slot_head_pre_merge" -m "$orig_msg") \
        || land_die "commit-tree failed while reordering merge parents"
      git update-ref -m "wt land: reorder merge parents" \
        "refs/heads/$branch" "$new_merge" "$post_merge_head" \
        || land_die "update-ref failed while reordering merge parents (raced?)"
      echo "land: normalized merge parents (main first-parent stays on mainline)"
    fi
  fi

  local slot_head
  slot_head=$(git rev-parse HEAD)

  # Advance main's existing submodule clones to the pinned commits, LOCALLY and
  # BEFORE the parent ff — so a failure (collision/divergence) leaves main at
  # main_before and the re-run retries the same set, never stranding the
  # operator half-landed. Fetch the slot sub's HEAD (= the pin) then ff-only
  # (refuses on collision/divergence). Local path source, no origin. Top-level
  # only; `.git` is a gitlink *file* (`-e`). See [[land-submodules.md]].
  #
  # new_subs: main has no clone (newly introduced/gone) — cloned from the slot
  # post-ff by _land_clone_sub_from_slot.
  local sub new_sha moved new_subs=()
  moved=$(git diff --raw "$main_before" "$slot_head" | awk '$2=="160000" {print $6}')
  while IFS= read -r sub; do
    [ -n "$sub" ] || continue
    [ -e "$slot_path/$sub/.git" ] || continue            # tag-excluded at acquire
    if [ ! -e "$main_path/$sub/.git" ]; then
      new_subs+=("$sub")
      continue
    fi
    new_sha=$(git -C "$slot_path/$sub" rev-parse HEAD) \
      || land_die "submodule '$sub': cannot read slot clone HEAD; main NOT advanced"
    git -C "$main_path/$sub" -c protocol.file.allow=always \
      fetch --quiet "$slot_path/$sub" HEAD \
      || land_die "submodule '$sub': local fetch from slot clone failed; main NOT advanced — re-run land"
    git_no_hooks -C "$main_path/$sub" merge --ff-only --quiet "$new_sha" \
      || land_die "submodule '$sub': cannot fast-forward $main_path/$sub to ${new_sha:0:7} (untracked collision or main-side divergence); main NOT advanced — resolve in $main_path/$sub and re-run land"
    echo "land: submodule $sub → ${new_sha:0:7}"
  done <<< "$moved"

  # Skip the no-op so re-runs are idempotent (e.g. after manual conflict fix).
  if [ "$main_before" != "$slot_head" ]; then
    # `merge --ff-only` advances whatever HEAD points to, not refs/heads/main by
    # name — anchor on the symref first.
    local main_ref
    main_ref=$(git -C "$main_path" symbolic-ref HEAD 2>/dev/null || true)
    [ "$main_ref" = "refs/heads/main" ] \
      || land_die "$main_path has $main_ref checked out, expected refs/heads/main"
    git_no_hooks -C "$main_path" merge --ff-only --quiet "$slot_head" \
      || land_die "fast-forward refused in $main_path — likely an untracked file at a path the slot adds; move/remove it and re-run"
  fi
  local main_after
  main_after=$(git rev-parse main)

  # Populate main's clones of newly-introduced submodules (collected above).
  # The ff recorded their gitlinks + .gitmodules; clone each from the slot's
  # populated clone. Non-fatal — main is already advanced — so failures warn.
  for sub in ${new_subs[@]+"${new_subs[@]}"}; do
    if _land_clone_sub_from_slot "$main_path" "$slot_path" "$sub"; then
      echo "land: submodule $sub populated in main → $(git -C "$main_path/$sub" rev-parse --short HEAD 2>/dev/null)"
    else
      land_warn "new submodule '$sub' not populated in $main_path — finish with: git -C $main_path -c protocol.file.allow=always submodule update --init -- $sub"
    fi
  done

  # Refresh the slot's submodule clones to the gitlinks main brought in via
  # `git merge main` (else `git status` shows phantom rewinds). Fetch each pin
  # locally from main's clone, then `submodule update`. Cosmetic — main is
  # already advanced — so failures only WARN. Diff slot_head_pre_merge→HEAD for
  # the merged-in gitlinks; `.git` guard skips additions with no slot clone.
  local main_brought refresh=()
  main_brought=$(git diff --raw "$slot_head_pre_merge" HEAD | awk '$2=="160000" {print $6}')
  while IFS= read -r sub; do
    [ -n "$sub" ] || continue
    [ -e "$slot_path/$sub/.git" ] || continue
    [ -e "$main_path/$sub/.git" ] || {
      land_warn "WARN: $sub: main worktree's submodule clone missing — slot not refreshed"
      continue
    }
    git -C "$slot_path/$sub" -c protocol.file.allow=always \
      fetch --quiet "$main_path/$sub" HEAD 2>/dev/null \
      || land_warn "WARN: $sub: local fetch from main clone failed — slot may stay stale"
    refresh+=("$sub")
  done <<< "$main_brought"
  if [ "${#refresh[@]}" -gt 0 ]; then
    git -C "$slot_path" -c protocol.file.allow=always \
      submodule update -- ${refresh[@]+"${refresh[@]}"} 2>/dev/null \
      || land_warn "WARN: slot submodule refresh incomplete — finish with: git -C $slot_path -c protocol.file.allow=always submodule update -- ${refresh[*]}"
  fi

  echo "land: $branch landed; main at $(git rev-parse --short HEAD)"

  # Post-land hook. Source from main_path — land runs without a pool key, and
  # main_path IS the source repo.
  export WT_MAIN_BEFORE="$main_before" WT_MAIN_AFTER="$main_after"
  source_hooks "$main_path"
  call_hook wt_post_land || true
}

cmd_cleanup() {
  local name="${1:-}"; shift || true
  [ -n "$name" ] || { echo "usage: cleanup <name>" >&2; exit 0; }

  local G Y R X
  if [ -t 1 ]; then
    G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[1;31m'; X=$'\e[0m'
  else
    G=''; Y=''; R=''; X=''
  fi

  # Ghost-dir guard FIRST — broken canonical dirs would otherwise look "already
  # recycled" since slot_path_for skips them (no branch = not held).
  local literal_path="$POOL_ROOT/$name"
  if [ -d "$literal_path" ] && ! slot_repo_ok "$literal_path"; then
    printf '%s🔴 BROKEN: %s — slot dir has no valid .git (partial-cleanup debris). NOT recycling.%s\n' \
      "$R" "$name" "$X" >&2
    printf '   Recover: rm -rf %q\n' "$literal_path" >&2
    exit 0
  fi

  local path
  path=$(slot_path_for "$name") || path=""

  if [ -z "$path" ] || [ ! -d "$path" ]; then
    printf '%s🟢 slot %s/%s already recycled%s\n' "$G" "$POOL_KEY" "$name" "$X"
    exit 0
  fi

  # Pre-cleanup hook. Best-effort — failure must not block the classifier.
  fire_hook wt_pre_cleanup 0 || true

  local marker
  marker=$(in_progress_marker "$path")
  if [ -n "$marker" ]; then
    printf '%s🟡 %s: in-progress %s — finish or abort first. NOT recycling.%s\n' \
      "$Y" "$name" "$marker" "$X" >&2
    exit 0
  fi

  local porcelain dirty untrk ahead
  porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
  read -r dirty untrk < <(printf '%s' "$porcelain" | awk 'NF{if(/^\?\?/)u++;else d++} END{print d+0, u+0}')

  ahead=0
  if a=$(ahead_count "$path" "$name"); then ahead="$a"; fi

  if [ "$ahead" != "0" ]; then
    printf '%s🔴 UNMERGED: %s has %s commit(s) not in main — NOT recycling.%s\n' \
      "$R" "$name" "$ahead" "$X" >&2
    printf '   git branch -D %s   # to discard\n' "$name" >&2
    exit 0
  fi
  if [ "$dirty" != "0" ] || [ "$untrk" != "0" ]; then
    printf '%s🟡 dirty: %s — %s modified, %s untracked. NOT recycling.%s\n' \
      "$Y" "$name" "$dirty" "$untrk" "$X" >&2
    exit 0
  fi

  # Only print 🟢 if release succeeded — else we'd lie about a still-broken slot.
  if "$0" --pool "$POOL_KEY" release --lease "$name"; then
    printf '%s🟢 recycled cleanly: %s/%s%s\n' "$G" "$POOL_KEY" "$name" "$X"
    call_hook wt_post_cleanup || true
  else
    printf '%s🔴 recycle failed: %s/%s — see error above. Slot left in place.%s\n' \
      "$R" "$POOL_KEY" "$name" "$X" >&2
  fi
}

# Run `cleanup` on every held slot. Operator-driven; catches orphans whose EXIT
# trap never fired (killed shell, hand-deleted branch, manual worktree adds).
# Always exits 0. Not serialized against parallel `wt go`s, but safe: release
# takes the pool mutex per-slot, and acquires reuse canonical slots in place
# (no rename), so iterating held branch names can't collide with idle-slot picks.
cmd_sweep() {
  [ $# -eq 0 ] || die "sweep takes no arguments"

  # Held slot names are column 3 of `worktree-pool ls` held rows.
  local out names
  out=$(worktree-pool --pool "$POOL_KEY" ls)
  names=$(held_data_rows "$out" | awk '{print $3}')
  if [ -z "$names" ]; then
    echo "(no held slots to sweep)"
    return 0
  fi

  local total=0 recycled=0 left=0 vanished=0 name before
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    total=$((total + 1))
    # Detect recycle via still-held-after state — cleanup always exits 0, so its
    # exit code is unreadable and its colored output is brittle to parse.
    before=1
    slot_path_for "$name" >/dev/null || before=0
    "$0" --pool "$POOL_KEY" cleanup "$name"
    if [ "$before" = 0 ]; then
      vanished=$((vanished + 1))
    elif ! slot_path_for "$name" >/dev/null; then
      recycled=$((recycled + 1))
    else
      left=$((left + 1))
    fi
  done <<< "$names"

  if [ "$vanished" = 0 ]; then
    printf -- '── sweep: %d slot(s), %d recycled, %d left in place ──\n' \
      "$total" "$recycled" "$left"
  else
    printf -- '── sweep: %d slot(s), %d recycled, %d left in place, %d vanished mid-sweep ──\n' \
      "$total" "$recycled" "$left" "$vanished"
  fi
}

cmd_release() {
  set -e
  # Pre-parse `--force`/`-f` (either side of positionals). `--force` skips the
  # dirty+unmerged safety but NOT the ghost-dir guard (broken slots need
  # `rm -rf`, not --force). Reject other `--*`/`-*` so a typo isn't treated as a
  # slot name; `--` ends options for names starting with `-` (rare).
  local force=0 args=() arg seen_endopts=0
  for arg in "$@"; do
    if [ "$seen_endopts" = 1 ]; then
      args+=("$arg")
      continue
    fi
    case "$arg" in
      --)         seen_endopts=1 ;;
      --force|-f) force=1 ;;
      --*|-*)     die "release: unknown flag '$arg' — usage: wt release <name> [--force|-f]" ;;
      *)          args+=("$arg") ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}

  local name="${1:-}"; shift || true
  # No name → release the slot cwd sits in; resolve its branch so the rest of
  # the flow matches an explicit `release NAME`.
  if [ -z "$name" ]; then
    local cwd_slot
    cwd_slot=$(slot_path_from_cwd) \
      || die "wt release [name] — no name given and cwd isn't inside a slot. Pass a name or cd into a slot."
    slot_repo_ok "$cwd_slot" \
      || die "cwd's slot at $cwd_slot is broken (no valid .git). Recover with: rm -rf $(printf '%q' "$cwd_slot")"
    name=$(git -C "$cwd_slot" symbolic-ref --short --quiet HEAD 2>/dev/null) \
      || die "cwd's slot at $cwd_slot is idle (detached HEAD) — nothing to release."
  fi
  require_arg name "$name" "wt release [name] [--force]"

  # Broken-dir guard: surface ghost dirs loudly (slot_path_for would skip them).
  local literal_path="$POOL_ROOT/$name"
  if [ -d "$literal_path" ] && ! slot_repo_ok "$literal_path"; then
    die "slot '$name' at $literal_path is broken (no valid .git). Recover with: rm -rf $(printf '%q' "$literal_path")"
  fi

  local path
  path=$(slot_path_for "$name") || die "no held slot with branch '$name' in pool '$POOL_KEY' at $POOL_ROOT.
  If the branch persists without a slot (orphan from manual cleanup),
  remove it directly:
    git branch -D $name && git push origin :$name   # only if merged into main"

  if ! slot_repo_ok "$path"; then
    die "slot '$name' at $path is broken (no valid .git). Recover with: rm -rf $(printf '%q' "$path")"
  fi

  if [ "$force" = 0 ]; then
    local porcelain
    porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
    if [ -n "$porcelain" ]; then
      echo "${0##*/}: '$name' is dirty — refusing. Pass --force to discard." >&2
      printf '%s\n' "$porcelain" | sed 's/^/  /' >&2
      exit 1
    fi

    local ahead
    if ahead=$(ahead_count "$path" "$name"); then
      if [ "$ahead" != "0" ]; then
        echo "${0##*/}: '$name' has $ahead commit(s) not in main — refusing. Pass --force to discard." >&2
        exit 1
      fi
    fi
  fi

  # Remote branch delete delegated to release.rs's silent push_delete.
  worktree-pool --pool "$POOL_KEY" release --lease "$name"
}

# Print the cwd context for an AI-agent bootstrap. One of:
#   worktree  ~/.worktree-pool/<key>/<name>    — cwd is inside a pool slot (feature worktree)
#   source    ~/Develop/<key>                  — cwd is inside a registered pool's source repo
#   none                                       — neither (no pool root, not in any registered repo)
# Path uses `~` for $HOME. Always exits 0.
cmd_whoami() {
  local cwd_real
  cwd_real=$(pwd -P)

  # Worktree: cwd is somewhere under $WORKTREE_ROOT/<key>/<name>/.
  if inside_dir "$WORKTREE_ROOT"; then
    local pool_root_real rel key rest name
    pool_root_real=$(cd "$WORKTREE_ROOT" && pwd -P)
    rel="${cwd_real#"$pool_root_real"/}"
    key="${rel%%/*}"
    rest="${rel#*/}"
    name="${rest%%/*}"
    # Bare pool root or $WORKTREE_ROOT/<key> with no slot below: not a worktree
    # context — fall through to none.
    if [ -n "$key" ] && [ "$rel" != "$key" ] && [ -n "$name" ]; then
      printf 'worktree\t%s\n' "$WORKTREE_ROOT/$key/$name" | sed "s|$HOME|~|"
      return 0
    fi
  fi

  # Source: git toplevel matches some pool's `source:`.
  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || { echo none; return 0; }
  toplevel=$(cd "$toplevel" && pwd -P)

  if [ -n "$(pool_keys_for_toplevel "$toplevel" | head -n1)" ]; then
    printf 'source\t%s\n' "$toplevel" | sed "s|$HOME|~|"
    return 0
  fi

  echo none
}

# Print the current repo's toplevel path and CLAUDE.md to stdout. Intended for
# AI-agent session bootstrap.
cmd_orient() {
  local repo
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "orient: not inside a git repo"
  printf '%s\n' "$repo"
  if [ -f "$repo/CLAUDE.md" ]; then
    printf '\n'
    cat "$repo/CLAUDE.md"
  fi
}

cmd_ls() {
  # Held slots only; drop ID (canonical slot-N — branch NAME is the real
  # identity), STATE (constant after filter), and GROUP when uniform. Use
  # `worktree-pool ls` for the full table incl idle rows. `--git-status` on by
  # default (DIRTY/UNTRK/AHEAD; cheap per held slot); `--bare` opts out.
  local bare=0 forward=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --bare)        bare=1 ;;
      --git-status)  ;;  # already on by default; accept for back-compat
      *)             forward+=("$arg") ;;
    esac
  done
  [ "$bare" = 0 ] && forward=(--git-status ${forward[@]+"${forward[@]}"})

  local out held
  out=$(worktree-pool --pool "$POOL_KEY" ls ${forward[@]+"${forward[@]}"})
  held=$(held_data_rows "$out")
  if [ -z "$held" ]; then
    echo "(no held slots)"
    return 0
  fi
  local drop_group=0
  [ "$(printf '%s\n' "$held" | awk '{print $4}' | sort -u | wc -l)" -le 1 ] && drop_group=1
  {
    printf '%s\n' "$out" | awk 'NR<=2'
    printf '%s\n' "$held"
  } | awk -v dg="$drop_group" '{$1=""; $2=""; if (dg) $4=""; print}' | column -t
}

# Initialize a pool, inferring --source from cwd's git toplevel and --pool from
# its basename. Other flags pass through; `--max-slots` defaults to 16.
cmd_init() {
  set -e

  # Refuse from inside any pool — `--show-toplevel` would resolve to the slot,
  # not the source repo.
  inside_dir "$WORKTREE_ROOT" \
    && die "init: refusing to run from inside a pool slot — cd into the source repo first."

  local source
  source=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "init: not inside a git repo — cd into the source repo first."
  source=$(cd "$source" && pwd -P)

  local key="${POOL_KEY:-$(basename "$source")}"

  local has_max_slots=0 a
  for a in "$@"; do
    case "$a" in --max-slots|--max-slots=*) has_max_slots=1; break ;; esac
  done
  (( has_max_slots )) || set -- --max-slots 16 "$@"

  exec worktree-pool --pool "$key" init --source "$source" "$@"
}

cmd_info() {
  local name="${1:-}"; shift || true
  require_arg name "$name" "wt info <name>"
  exec worktree-pool --pool "$POOL_KEY" inspect --lease "$name" "$@"
}

# ---------- help ----------

# Per-verb usage. `wt help [verb]` and `wt <verb> --help` route here; blocks
# mirror docs/wt.md so the CLI is self-documenting.
print_help() {
  local verb="${1:-}"
  case "$verb" in
    init)
      cat <<'EOF'
wt [--pool <key>] init [--max-slots <n>] [pool-init-flags...]

Initialize a pool. --source inferred from `git rev-parse --show-toplevel`,
--pool from its basename. --max-slots defaults to 16. All other flags pass
through to `worktree-pool init` (e.g. --groups ios,android).
Refuses from inside an existing pool slot.
EOF
      ;;
    path)
      cat <<'EOF'
wt [--pool <key>] path <name>

Print the absolute slot path. Exit 0 if slot exists, 1 if not, 2 on error.
Lets scripts branch on resume vs. fresh acquire.
EOF
      ;;
    acquire)
      cat <<'EOF'
wt [--pool <key>] acquire <name> [--from <commit-ish>] [pool-acquire-flags...]

Acquire a slot and print its path. No session launch, no cleanup trap — the
plain primitive with pool-key inference and `--from` (→ acquire --commit).
EOF
      ;;
    go)
      cat <<'EOF'
wt [--pool <key>] go <name> [--from <commit-ish>] [pool-acquire-flags...]

Acquire (or resume) a slot, cd into it, launch $WT_LAUNCHER (default `ai`)
with `-n <name>`, and set an EXIT trap that runs `wt cleanup`. On resume,
acquire flags are ignored — slot stays at its existing commit; the launcher
is invoked with --continue.

  --from <ref>   fork from <commit-ish> (passed as --commit to acquire)
EOF
      ;;
    release)
      cat <<'EOF'
wt [--pool <key>] release [name] [--force|-f]

Manual safety-checked release. Refuses on dirty working tree or commits not
in main; refuses 🔴 BROKEN slots (recover via `rm -rf`).
  [name]         branch of the slot to release; defaults to the slot cwd
                 sits in (resolved via its current branch)
  --force / -f   discard dirty tracked changes and unmerged commits
EOF
      ;;
    cleanup)
      cat <<'EOF'
wt [--pool <key>] cleanup <name>

EXIT-trap classifier (always exits 0). Markers:
  🟢 clean + 0 ahead local main → detach HEAD + delete branch (recycle)
  🟡 dirty / untracked          → leave personalized; resume with `wt go`
  🔴 UNMERGED                    → operator resolves before recycling
  🔴 BROKEN                      → slot dir has no valid .git; rm -rf to recover
EOF
      ;;
    sweep)
      cat <<'EOF'
wt [--pool <key>] sweep

Run `cleanup` over every held slot in the pool. Catches orphans whose
EXIT trap never fired (detached HEAD with deleted branch, killed shell,
manual `git worktree add`-then-abandon, etc.). Prints a per-slot marker
and a final tally. Always exits 0.
EOF
      ;;
    ls)
      cat <<'EOF'
wt [--pool <key>] ls [--bare]

Show held slots only (use `worktree-pool ls` for full table including idle).
By default includes git status columns: NAME, DIRTY, UNTRK, AHEAD —
`(detached)` or a non-name branch in NAME flags slots that won't recycle
on cleanup, AHEAD>0 flags unmerged.
  --bare        skip the per-slot git status calls (faster)
EOF
      ;;
    info)
      cat <<'EOF'
wt [--pool <key>] info <name>

Pass-through to `worktree-pool inspect <name>` with the inferred pool
key prefilled. Prints slot state + git status -sb + recent log.
EOF
      ;;
    land)
      cat <<'EOF'
wt land [message]

Local-only fast-forward of slot's commits onto local `main`. Auto-commits
dirty tracked work using <message> (refuses if dirty without one; `wip`
shorthand → `WIP via land`). Bidirectional submodule sync. Never fetches,
pushes, or opens a PR. Operates on cwd's slot; no pool key needed.
See docs/wt.md §Land flow for the full step list.
EOF
      ;;
    whoami)
      cat <<'EOF'
wt whoami

Print cwd context for AI-agent bootstrap: `worktree <path>`,
`source <path>`, or `none`. Path uses `~` for $HOME. Always exits 0.
EOF
      ;;
    orient)
      cat <<'EOF'
wt orient

Print current repo's toplevel path followed by its CLAUDE.md. Refuses if
not inside a git repo. Intended for AI-agent session bootstrap.
EOF
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
wt — dev-session wrapper around `worktree-pool`.

Pool lifecycle:
  init     initialize a pool (run from inside the source repo)
  acquire  acquire a slot and print its path (no session)
  go       acquire/resume a slot and launch a session
  release  safety-checked release of a slot
  cleanup  classifier invoked by `go`'s EXIT trap (🟢/🟡/🔴)
  sweep    run cleanup over every held slot

Inspection:
  path     print absolute slot path; exit code = exists predicate
  ls       held slots + git status (NAME/DIRTY/UNTRK/AHEAD)
  info     full slot inspection (state + status + log)

Workflow:
  land     ff slot's commits onto local main (no push, no PR)

Bootstrap:
  whoami   cwd context (worktree|source|none)
  orient   print current repo + its CLAUDE.md

Pool-key auto-resolution: --pool inferred from cwd (slot or source repo).
Override with --pool <key> / -p <key> before the verb.

Per-verb help:  wt help <verb>   (or wt <verb> --help)
EOF
      ;;
    *)
      die "no help for unknown verb '$verb'"
      ;;
  esac
}

# ---------- dispatch ----------

POOL_KEY=""
# `--pool <key>` / `-p <key>` anywhere before the verb.
while [ $# -gt 0 ]; do
  case "$1" in
    --pool)   [ $# -ge 2 ] || die "--pool requires an argument"; POOL_KEY="$2"; shift 2 ;;
    --pool=*) POOL_KEY="${1#--pool=}"; shift ;;
    -p)       [ $# -ge 2 ] || die "-p requires an argument"; POOL_KEY="$2"; shift 2 ;;
    *)        break ;;
  esac
done

verb="${1:-}"; shift || true

# Top-level help: `wt`, `wt --help`, `wt -h`, `wt help [verb]`.
case "$verb" in
  ""|--help|-h) print_help ""; exit 0 ;;
  help)         print_help "${1:-}"; exit 0 ;;
esac

# Per-verb help: `--help`/`-h` anywhere in args. Routes before the subcommand
# sees the args so `--help` isn't treated as a positional (slot name).
for arg in "$@"; do
  case "$arg" in
    --help|-h) print_help "$verb"; exit 0 ;;
  esac
done

case "$verb" in
  init)    cmd_init    "$@" ;;
  path)    require_pool; cmd_path    "$@" ;;
  go)      require_pool; cmd_go      "$@" ;;
  acquire) require_pool; cmd_acquire "$@" ;;
  land)    cmd_land    "$@" ;;
  cleanup) require_pool; cmd_cleanup "$@" ;;
  _exit_handler) require_pool; cmd__exit_handler "$@" ;;
  _land_clone_sub_from_slot) _land_clone_sub_from_slot "$@" ;;
  sweep)   require_pool; cmd_sweep   "$@" ;;
  release) require_pool; cmd_release "$@" ;;
  orient)  cmd_orient  "$@" ;;
  whoami)  cmd_whoami  "$@" ;;
  ls)      require_pool; cmd_ls      "$@" ;;
  info)    require_pool; cmd_info    "$@" ;;
  *)       die "unknown verb '$verb'. Run \`${0##*/} help\` for the full list." ;;
esac
