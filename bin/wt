#!/usr/bin/env bash
# wt — convenience wrapper around `worktree-pool` for the common dev-session
# lifecycle: acquire + launch an interactive shell + safe-recycle on exit.
# See https://github.com/studio-boxcat/worktree-pool
#
# Usage:
#   wt [--pool <key>] init    [--max-slots <n>] [pool-init-flags...]   # default --max-slots 16
#   wt [--pool <key>] go      <name> [--from <commit-ish>] [pool-acquire-flags...]
#   wt [--pool <key>] rm      <name> [--force]
#   wt [--pool <key>] cleanup <name>     # 🟢/🟡/🔴 exit-trap classifier
#   wt [--pool <key>] path    <name>     # exit 0 if exists, 1 if not, 2 on error
#   wt [--pool <key>] ls      [--git-status]
#   wt [--pool <key>] info    <name>
#   wt land   [message]                  # commit dirty work + ff slot's commits onto local main (local-only; no push, no PR)
#   wt whoami                            # cwd context: worktree|source|none + path
#   wt orient                            # print current repo path + CLAUDE.md
#
# `init` infers --source from `git rev-parse --show-toplevel` and --pool from
# its basename; pass --pool <key> to override. All other init flags pass through.
#
# Pool root: $WORKTREE_ROOT (required — no fallback). Set in ~/.zshenv.local.
#
# Pool key auto-resolution (override with --pool):
#   1. cwd inside $WORKTREE_ROOT/<key>/<name>/...  → key derived from path
#   2. cwd inside a git repo whose toplevel matches some pool's `source:`
#   3. error if zero or multiple matches
#
# Hooks: if `<source>/.wt-hooks.sh` exists, it is sourced before lifecycle
# verbs run. Define any of these bash functions to extend behavior; all see
# $WT_KEY $WT_NAME $WT_PATH $WT_FRESH (1=fresh acquire, 0=resume) in env:
#
#   wt_pre_go       — runs after acquire/resume, before launching the shell
#   wt_pre_rm       — runs after safety checks, before `release`
#   wt_pre_cleanup  — runs before the cleanup classifier
#   wt_post_cleanup — runs after classifier, only on the green/recycled path
#   wt_post_land    — runs after land succeeds; sees $WT_MAIN_BEFORE/$WT_MAIN_AFTER
#
# Hook scripts may also set:
#   WT_LAUNCHER     — launcher invocation; default `ai`. Receives `-n <name>`
#                     (and `--continue` on resume) appended.

set -uo pipefail   # set -e is per-subcommand (cleanup must always exit 0).

# Fresh-acquire launches that return in <N seconds are suspect — claude/ai
# couldn't have started a real session. We warn before the EXIT trap recycles.
readonly LAUNCH_MISFIRE_SECS=3

# ---------- helpers ----------

die() { echo "${0##*/}: $*" >&2; exit 1; }

# WORKTREE_ROOT is required. No fallback — every pool path is anchored here, so
# silent default-to-$HOME/.worktree-pool would mis-locate state on hosts that
# put the pool elsewhere (external SSD, etc.).
[ -n "${WORKTREE_ROOT:-}" ] \
  || die "WORKTREE_ROOT is unset. Add 'export WORKTREE_ROOT=\"\$HOME/.worktree-pool\"' to ~/.zshenv.local (or equivalent) and reopen your shell."

require_arg() { [ -n "$2" ] || die "usage: $3"; }

pool_root_path() { printf '%s/%s' "$WORKTREE_ROOT" "$1"; }

# Read `source:` from a pool's config and expand `~`. Empty on failure.
pool_source_path() {
  local cfg="$WORKTREE_ROOT/$1/.meta/config.yaml"
  [ -f "$cfg" ] || return 1
  local src
  src=$(awk -F': *' '/^source:/ {print $2; exit}' "$cfg")
  [ -n "$src" ] || return 1
  printf '%s' "${src/#\~/$HOME}"
}

# Echo the name of any in-progress git operation (rebase, merge, cherry-pick,
# revert) for the repo at $1. Empty if clean.
in_progress_marker() {
  local git_dir
  git_dir=$(git -C "$1" rev-parse --git-dir 2>/dev/null || true)
  [ -z "$git_dir" ] && return 0
  local marker
  for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$git_dir/$marker" ]; then
      printf '%s' "$marker"
      return 0
    fi
  done
}

# Echo count of commits in <branch> not in main. '?' on rev-list failure.
# Returns 1 if the branch ref doesn't exist.
ahead_count() {
  local path=$1 branch=$2
  git -C "$path" show-ref --quiet --verify "refs/heads/$branch" || return 1
  git -C "$path" rev-list --count "main..$branch" 2>/dev/null || echo '?'
}

# True iff <slot-path>/.git exists AND resolves. The existence prefix prevents
# git's upward-walk on a missing gitlink from passing by accident (e.g. user
# has $HOME/.git for dotfiles).
slot_repo_ok() {
  [ -e "$1/.git" ] && git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

# True iff cwd is somewhere under $1 (after symlink resolution on both sides).
# Returns 1 if $1 doesn't exist — caller decides whether that's a refuse or a pass.
inside_dir() {
  [ -d "$1" ] || return 1
  local cwd_real root_real
  cwd_real=$(pwd -P)
  root_real=$(cd "$1" && pwd -P)
  [[ "$cwd_real" == "$root_real"/* ]]
}

# Find the absolute path of the worktree that has refs/heads/main checked out.
# Echoes empty string if no worktree holds main. Pool slots are themselves
# `git worktree`s of source, so from any slot this returns the source path.
find_main_path() {
  git worktree list --porcelain | awk '
    /^worktree /{p=substr($0, 10)}
    /^branch refs\/heads\/main$/{print p; exit}
  '
}

# Auto-resolve pool key from cwd. Echoes the key on stdout, returns non-zero
# (with stderr explanation) on ambiguity / no match.
auto_pool_key() {
  local cwd_real
  cwd_real=$(pwd -P)

  if [ -d "$WORKTREE_ROOT" ]; then
    local pool_root_real
    pool_root_real=$(cd "$WORKTREE_ROOT" && pwd -P)
    if [[ "$cwd_real" == "$pool_root_real"/* ]]; then
      local rel="${cwd_real#$pool_root_real/}"
      printf '%s' "${rel%%/*}"
      return 0
    fi
  fi

  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  toplevel=$(cd "$toplevel" && pwd -P)

  local matches=() cfg key src
  for cfg in "$WORKTREE_ROOT"/*/.meta/config.yaml; do
    [ -f "$cfg" ] || continue
    key=$(basename "$(dirname "$(dirname "$cfg")")")
    src=$(pool_source_path "$key") || continue
    src=$(cd "$src" 2>/dev/null && pwd -P) || continue
    if [ "$src" = "$toplevel" ]; then
      matches+=("$key")
    fi
  done

  case ${#matches[@]} in
    0) return 1 ;;
    1) printf '%s' "${matches[0]}"; return 0 ;;
    *) echo "wt: cwd matches multiple pools (${matches[*]}) — pass --pool <key>" >&2; return 2 ;;
  esac
}

# Globals set by require_pool: POOL_KEY POOL_ROOT POOL_SOURCE
require_pool() {
  if [ -z "${POOL_KEY:-}" ]; then
    POOL_KEY=$(auto_pool_key) || die "could not infer --pool from cwd. \
Run from inside a pool's source repo or a slot, or pass --pool <key>."
  fi
  POOL_ROOT=$(pool_root_path "$POOL_KEY")
  [ -d "$POOL_ROOT" ] || die "pool '$POOL_KEY' not initialized at $POOL_ROOT — \
from inside the source repo, run: wt init [--max-slots <n>] [--groups ...]"
}

# Lazily resolve `source:` from pool config. Cached in POOL_SOURCE on first call
# so verbs that don't need it (ls, info, path) skip the awk fork.
pool_source() {
  [ -n "${POOL_SOURCE:-}" ] && { printf '%s' "$POOL_SOURCE"; return 0; }
  POOL_SOURCE=$(pool_source_path "$POOL_KEY") || die "pool '$POOL_KEY' has no source: in config.yaml"
  printf '%s' "$POOL_SOURCE"
}

# Source <hooks-base>/.wt-hooks.sh if present. Defaults to the pool source repo.
source_hooks() {
  local base="${1:-$(pool_source)}"
  local hooks_file="$base/.wt-hooks.sh"
  if [ -f "$hooks_file" ]; then
    # shellcheck source=/dev/null
    source "$hooks_file"
  fi
}

# Call hook function $1 if defined, passing remaining args. Returns 0 when
# absent so callers under `set -e` aren't aborted by the missing-fn case
# (a bare `declare -F … && fn` would propagate declare's non-zero return).
call_hook() {
  local fn="$1"; shift
  if declare -F "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  fi
}

# Common prelude for hook fire points: export the WT_* env contract, source
# the hooks file, then invoke the named hook. $name and $path come from the
# enclosing function's locals (bash dynamic scoping).
fire_hook() {
  local hook_name="$1" fresh="$2"
  export WT_KEY="$POOL_KEY" WT_NAME="$name" WT_PATH="$path" WT_FRESH="$fresh"
  source_hooks
  call_hook "$hook_name"
}

# ---------- subcommands ----------

# Print the absolute slot path. Always emits the path on stdout (when the pool
# is valid) so callers that only need exists/not can `>/dev/null` it. Exit:
#   0 — slot exists at that path (resumable / introspectable)
#   1 — pool exists but slot doesn't
#   2 — usage error or pool not initialized
cmd_path() {
  local name="${1:-}"; shift || true
  if [ -z "$name" ]; then
    echo "usage: ${0##*/} path <name>" >&2
    exit 2
  fi
  local path="$POOL_ROOT/$name"
  printf '%s\n' "$path"
  [ -d "$path" ]
}

cmd_go() {
  set -e
  local name="${1:-}"; shift || true
  # Bare `wt go`: show currently-held slots so the operator can see what's
  # already in flight before typing a name, then a usage warning so the
  # missing arg is unambiguous (vs. a silent ls). Idle/fresh rows are
  # filtered out — uninteresting noise at this prompt.
  if [ -z "$name" ]; then
    local ls_out
    ls_out=$(worktree-pool --pool "$POOL_KEY" ls)
    local held_rows
    held_rows=$(printf '%s\n' "$ls_out" | awk 'NR>2 && $2=="held"')
    if [ -n "$held_rows" ]; then
      printf '%s\n' "$ls_out" | awk 'NR<=2'
      printf '%s\n' "$held_rows"
    else
      echo "(no held slots)"
    fi
    echo
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%swt go: name required.%s Pick an existing slot to resume, or a new name:\n  wt go <name> [--from <commit-ish>]\n' "$Y" "$X" >&2
    exit 2
  fi

  # Translate `--from <X>` → `--commit <X>` for the underlying acquire.
  local acquire_args=() from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)     [ $# -ge 2 ] || die "--from requires an argument"; from="$2"; shift 2 ;;
      --from=*)   from="${1#--from=}"; shift ;;
      *)          acquire_args+=("$1"); shift ;;
    esac
  done
  # `${arr[@]+...}` form keeps empty-array expansion safe under bash 3.2's `set -u`.
  [ -n "$from" ] && acquire_args=(--commit "$from" ${acquire_args[@]+"${acquire_args[@]}"})

  inside_dir "$POOL_ROOT" && die "refusing to nest — already inside a pool slot."

  # If a slot with this name already exists, resume it instead of acquiring.
  # Warn loudly — `--from` and other acquire flags are ignored on resume
  # (slot stays at its existing commit). A dir whose `.git` gitlink is missing
  # or dangling (ghost slot — partial cleanup debris) is NOT resumable; we
  # refuse loudly so the operator can decide between recovery and rm -rf.
  local path existing=0
  if [ -d "$POOL_ROOT/$name" ]; then
    existing=1
    path="$POOL_ROOT/$name"
    if ! slot_repo_ok "$path"; then
      die "slot '$name' at $path is broken (no valid .git — likely partial-cleanup debris). \
Recover with: rm -rf $(printf '%q' "$path"), then re-run."
    fi
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ slot %s/%s already exists — resuming (acquire flags ignored). Use `%s rm %s` first to recreate.%s\n' \
      "$Y" "$POOL_KEY" "$name" "${0##*/}" "$name" "$X" >&2
  else
    path=$(worktree-pool --pool "$POOL_KEY" acquire --name "$name" ${acquire_args[@]+"${acquire_args[@]}"} | tail -1)
    if [[ -z "$path" || ! -d "$path" ]]; then
      die "pool returned no path."
    fi
  fi

  # EXIT trap. Always invokes `wt cleanup`; project-specific extras are layered
  # via wt_pre_cleanup / wt_post_cleanup hooks instead of replacing the trap.
  # $WT_* expands at trap-fire time so the trap sees the right slot.
  export WT_KEY="$POOL_KEY" WT_NAME="$name"
  trap "'$0' --pool \"\$WT_KEY\" cleanup \"\$WT_NAME\"" EXIT

  printf '\n──── session: %s/%s @ %s ────\n\n' "$POOL_KEY" "$name" "$path"

  # Pre-launch hook (deps install, dev-server start, etc). Non-zero exit aborts
  # launch under set -e and triggers the EXIT trap.
  local fresh; fresh=$([ "$existing" = 0 ] && echo 1 || echo 0)
  fire_hook wt_pre_go "$fresh"

  # `-n <name>` sets claude's session display name (prompt box, /resume picker,
  # terminal title). `--append-system-prompt` warns subagents about the
  # cross-worktree refs/stash race (the per-slot alias enforces it; this is the
  # in-band reminder so models pick the right pattern up front). Both flags
  # assume the launcher accepts them — true for `claude` and the default `ai`
  # wrapper. printf %q quotes for the inline `zsh -ic` shell.
  local launcher="${WT_LAUNCHER:-ai}"
  local wt_prompt
  wt_prompt="You are inside a worktree-pool slot ($POOL_KEY/$name). Never run \`git stash\` here — \
the per-slot alias refuses it anyway because refs/stash is shared across worktrees of the same repo. \
For save/restore around tests use commit + soft-reset instead: \
\`git add -A && git commit -m wip ; ... ; git reset --soft HEAD^\`."
  local cmd
  printf -v cmd '%s -n %q --append-system-prompt %q' "$launcher" "$name" "$wt_prompt"
  [ "$existing" = 1 ] && cmd="$cmd --continue"

  # `set +e` for the subshell so a non-zero exit doesn't trip cmd_go's `set -e`
  # before we can print the misfire warning below.
  local launch_start launch_dur
  launch_start=${EPOCHSECONDS:-$(date +%s)}
  set +e
  (cd "$path" && exec "${SHELL:-zsh}" -ic "$cmd")
  set -e
  launch_dur=$(( ${EPOCHSECONDS:-$(date +%s)} - launch_start ))

  if [ "$launch_dur" -lt "$LAUNCH_MISFIRE_SECS" ] && [ "$existing" = 0 ]; then
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ launcher (%s) exited after %ss — likely misfired (auth, env, missing TTY, or %s not on PATH).\n  Slot will be auto-recycled by the EXIT trap. Re-run after fixing, or use `%s rm --force %s` if you need a clean retry.%s\n' \
      "$Y" "$launcher" "$launch_dur" "$launcher" "${0##*/}" "$name" "$X" >&2
  fi
}

# Land slot's commits onto local main: auto-commit dirty work, ff main → slot HEAD.
# Local-only — never fetches, never pushes, never opens a PR. See docs/wt.md §Land flow.
cmd_land() {
  set -e
  local msg="${1:-}"

  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$branch" = "main" ] || [ "$branch" = "HEAD" ]; then
    die "land: must run from a non-main branch (current: $branch)"
  fi

  local marker
  marker=$(in_progress_marker .)
  if [ -n "$marker" ]; then
    echo "land: in-progress $marker — finish or abort first." >&2
    echo "After finishing the merge commit, re-run land." >&2
    exit 1
  fi

  local untracked
  untracked=$(git ls-files --others --exclude-standard)
  if [ -n "$untracked" ]; then
    echo "land: untracked files — add, ignore, or remove first:" >&2
    printf '%s\n' "$untracked" | sed 's/^/  /' >&2
    exit 1
  fi

  local main_path
  main_path=$(find_main_path)
  [ -n "$main_path" ] || die "land: main is not checked out in any worktree"

  # `merge --ff-only` refuses if untracked files would be overwritten, so
  # untracked content in main is preserved; ignore `??` here when checking
  # for tracked-uncommitted state.
  local main_dirty
  main_dirty=$(git -C "$main_path" status --porcelain | awk '!/^\?\?/')
  if [ -n "$main_dirty" ]; then
    echo "land: main worktree ($main_path) has uncommitted tracked changes:" >&2
    printf '%s\n' "$main_dirty" | sed 's/^/  /' >&2
    exit 1
  fi

  # Auto-commit dirty tracked work. Refuse silent WIP commits.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    if [ -z "$msg" ]; then
      echo "land: dirty tracked work needs a commit message:" >&2
      git status --short >&2
      echo >&2
      echo "  wt land \"feat: <what you did>\"" >&2
      echo "  wt land wip                        # shorthand → 'WIP via land'" >&2
      exit 1
    fi
    [ "$msg" = "wip" ] && msg="WIP via land"
    git add -u
    git commit -m "$msg"
  fi

  # Capture pre-merge main for wt_post_land hook.
  local main_before
  main_before=$(git rev-parse main)

  # Merge main. Common case (no parallel land): main is ancestor of slot HEAD,
  # so this is a no-op ("Already up to date.") — slot's commits will fast-forward
  # main below. Only when a parallel slot has advanced main do we get a real
  # 3-way merge (with potential conflicts; resume = re-run after manual commit).
  if ! git merge -m "Merge main into $branch" main; then
    echo >&2
    echo "land: merge halted with conflicts. Resolve and either:" >&2
    echo "  • finish: 'git add' the files, 'git commit', then re-run land" >&2
    echo "  • back out: 'git merge --abort'" >&2
    exit 1
  fi

  # Refuse if a parallel slot's land advanced main past our merge base during
  # conflict resolution — `merge --ff-only` below would also catch this, but
  # this gives the operator a precise message.
  if ! git merge-base --is-ancestor main HEAD; then
    echo "land: main has moved past your merge base (parallel slot landed first)." >&2
    echo "  Re-merge with 'git merge main', resolve, commit, then re-run." >&2
    exit 1
  fi

  local slot_head slot_path
  slot_head=$(git rev-parse HEAD)
  slot_path=$(git rev-parse --show-toplevel)

  # Order: submodule propagation BEFORE parent ff-merge. If propagation fails,
  # parent stays at main_before and re-running land retries cleanly (each
  # submodule's fetch+attach+ff is idempotent — already-advanced submodules
  # no-op). The reverse order would strand the operator: parent advanced,
  # `moved` empty next time, failed submodules never retried.
  #
  # `acquire` branched each submodule as `<slot-name>`, so we fetch by branch
  # name from the slot's submodule into main's, then ff-merge to the gitlink-
  # expected SHA. ff-only refuses on untracked-overwrite — preserves operator
  # scratch in actively-edited submodule clones. `-e` not `-d`: a submodule's
  # `.git` is a gitlink *file*, never a directory. Parallel via background
  # subshells (Nx speedup at 7+ submodules; output interleaves). Top-level
  # only; nested propagation deferred (see docs/wt.md §Land flow).
  local moved
  moved=$(git diff --raw "$main_before" "$slot_head" | awk '$2=="160000" {print $6}')
  if [ -n "$moved" ]; then
    local pids=() pid sub_failed=0
    while IFS= read -r sub; do
      [ -n "$sub" ] || continue
      # Slot's submodule absent (tag-excluded at acquire) — nothing to propagate.
      [ -e "$slot_path/$sub/.git" ] || continue
      [ -e "$main_path/$sub/.git" ] \
        || die "land: main worktree's submodule clone missing at $main_path/$sub"
      (
        new_sha=$(git -C "$slot_path/$sub" rev-parse HEAD)
        git -C "$main_path/$sub" fetch --quiet "$slot_path/$sub" "$branch"
        # Attach detached HEAD before ff-merge so the branch ref tracks the
        # gitlink (post-`git submodule update` is detached → ff-only on
        # detached only moves HEAD). `.gitmodules` lookup assumes name == path
        # (the `git submodule add` default).
        if ! git -C "$main_path/$sub" symbolic-ref -q HEAD >/dev/null; then
          local sub_branch="" attach_target=""
          sub_branch=$(git -C "$slot_path" config -f .gitmodules \
            --get "submodule.$sub.branch" 2>/dev/null || true)
          if [ -n "$sub_branch" ] \
              && git -C "$main_path/$sub" show-ref --verify --quiet "refs/heads/$sub_branch"; then
            attach_target="$sub_branch"
          elif git -C "$main_path/$sub" show-ref --verify --quiet refs/heads/main; then
            attach_target="main"
          fi
          if [ -n "$attach_target" ]; then
            git -C "$main_path/$sub" checkout --quiet "$attach_target" \
              || die "land: checkout $attach_target failed in $main_path/$sub (untracked collision?)"
          fi
        fi
        git -c core.hooksPath=/dev/null -C "$main_path/$sub" \
          merge --ff-only --quiet "$new_sha"
        echo "land: submodule $sub → ${new_sha:0:7}"
      ) &
      pids+=($!)
    done <<< "$moved"
    for pid in "${pids[@]}"; do wait "$pid" || sub_failed=1; done
    [ "$sub_failed" = 0 ] \
      || die "land: submodule propagation failed (see above); main NOT advanced — fix and re-run land"
  fi

  # Skip the no-op so re-runs are idempotent (e.g. after manual conflict resolution).
  if [ "$main_before" != "$slot_head" ]; then
    # `merge --ff-only` advances whatever HEAD points to, not refs/heads/main
    # by name — so anchor on the symref before letting it run.
    local main_ref
    main_ref=$(git -C "$main_path" symbolic-ref HEAD 2>/dev/null || true)
    [ "$main_ref" = "refs/heads/main" ] \
      || die "land: $main_path has $main_ref checked out, expected refs/heads/main"
    # core.hooksPath=/dev/null: don't fire user repos' post-merge —
    # wt_post_land is the documented hook surface.
    git -c core.hooksPath=/dev/null -C "$main_path" merge --ff-only --quiet "$slot_head" \
      || die "land: fast-forward refused in $main_path — likely an untracked file at a path the slot adds; move/remove it and re-run"
  fi
  local main_after
  main_after=$(git rev-parse main)

  echo "land: $branch merged; main at $(git rev-parse --short HEAD)"

  # Post-land hook (deps-changed advisory etc). Source hooks from main_path
  # since land runs without a pool key — main_path IS the source repo.
  export WT_MAIN_BEFORE="$main_before" WT_MAIN_AFTER="$main_after"
  source_hooks "$main_path"
  call_hook wt_post_land || true
}

cmd_cleanup() {
  local name="${1:-}"; shift || true
  [ -n "$name" ] || { echo "usage: cleanup <name>" >&2; exit 0; }

  local path="$POOL_ROOT/$name"

  local G Y R X
  if [ -t 1 ]; then
    G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[1;31m'; X=$'\e[0m'
  else
    G=''; Y=''; R=''; X=''
  fi

  if [ ! -d "$path" ]; then
    printf '%s🟢 slot %s/%s already recycled%s\n' "$G" "$POOL_KEY" "$name" "$X"
    exit 0
  fi

  # Ghost-dir guard: slot dir exists but `.git` is missing or dangling.
  if ! slot_repo_ok "$path"; then
    printf '%s🔴 BROKEN: %s — slot dir has no valid .git (partial-cleanup debris). NOT recycling.%s\n' \
      "$R" "$name" "$X" >&2
    printf '   Recover: rm -rf %q\n' "$path" >&2
    exit 0
  fi

  # Pre-cleanup hook (e.g. dev-server stop). Best-effort — failure here
  # shouldn't block the classifier from running.
  fire_hook wt_pre_cleanup 0 || true

  local marker
  marker=$(in_progress_marker "$path")
  if [ -n "$marker" ]; then
    printf '%s🟡 %s: in-progress %s — finish or abort first. NOT recycling.%s\n' \
      "$Y" "$name" "$marker" "$X" >&2
    exit 0
  fi

  local porcelain dirty untrk ahead
  porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
  read -r dirty untrk < <(printf '%s' "$porcelain" | awk 'NF{if(/^\?\?/)u++;else d++} END{print d+0, u+0}')

  ahead=0
  if a=$(ahead_count "$path" "$name"); then ahead="$a"; fi

  if [ "$ahead" != "0" ]; then
    printf '%s🔴 UNMERGED: %s has %s commit(s) not in main — NOT recycling.%s\n' \
      "$R" "$name" "$ahead" "$X" >&2
    printf '   git branch -D %s   # to discard\n' "$name" >&2
    exit 0
  fi
  if [ "$dirty" != "0" ] || [ "$untrk" != "0" ]; then
    printf '%s🟡 dirty: %s — %s modified, %s untracked. NOT recycling.%s\n' \
      "$Y" "$name" "$dirty" "$untrk" "$X" >&2
    exit 0
  fi

  # Only print 🟢 if release actually succeeded — silencing rm's exit code
  # would lie about a still-broken slot.
  if "$0" --pool "$POOL_KEY" rm "$name"; then
    printf '%s🟢 recycled cleanly: %s/%s%s\n' "$G" "$POOL_KEY" "$name" "$X"
    call_hook wt_post_cleanup || true
  else
    printf '%s🔴 recycle failed: %s/%s — see error above. Slot left in place.%s\n' \
      "$R" "$POOL_KEY" "$name" "$X" >&2
  fi
}

cmd_rm() {
  set -e
  # Pre-parse `--force` / `-f` so it can appear before or after positionals.
  # `--force` skips the work-preservation safety (dirty + unmerged); the
  # ghost-dir guard remains because release physically can't run without git
  # state — broken slots need explicit `rm -rf`, not --force.
  local force=0 args=() arg
  for arg in "$@"; do
    case "$arg" in
      --force|-f) force=1 ;;
      *)          args+=("$arg") ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}

  local name="${1:-}"; shift || true
  require_arg name "$name" "wt rm <name> [--force]"

  local path="$POOL_ROOT/$name"
  [ -d "$path" ] || die "no slot named '$name' in pool '$POOL_KEY' at $POOL_ROOT.
  If the slot dir is gone but the branch persists (orphan from manual cleanup),
  remove it directly:
    git branch -D $name && git push origin :$name   # only if merged into main"

  if ! slot_repo_ok "$path"; then
    die "slot '$name' at $path is broken (no valid .git). Recover with: rm -rf $(printf '%q' "$path")"
  fi

  if [ "$force" = 0 ]; then
    local porcelain
    porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
    if [ -n "$porcelain" ]; then
      echo "${0##*/}: '$name' is dirty — refusing. Pass --force to discard." >&2
      printf '%s\n' "$porcelain" | sed 's/^/  /' >&2
      exit 1
    fi

    local ahead
    if ahead=$(ahead_count "$path" "$name"); then
      if [ "$ahead" != "0" ]; then
        echo "${0##*/}: '$name' has $ahead commit(s) not in main — refusing. Pass --force to discard." >&2
        exit 1
      fi
    fi
  fi

  # Pre-rm hook (e.g. dev-server stop). Best-effort.
  fire_hook wt_pre_rm 0 || true

  # Remote branch delete is delegated to release.rs's silent push_delete
  # (best-effort).
  worktree-pool --pool "$POOL_KEY" release --name "$name"
}

# Print the cwd context for an AI-agent bootstrap. One of:
#   worktree  ~/.worktree-pool/<key>/<name>    — cwd is inside a pool slot (feature worktree)
#   source    ~/Develop/<key>                  — cwd is inside a registered pool's source repo
#   none                                       — neither (no pool root, not in any registered repo)
# Path uses `~` for $HOME. Always exits 0.
cmd_whoami() {
  local cwd_real
  cwd_real=$(pwd -P)

  # Worktree: cwd is somewhere under $WORKTREE_ROOT/<key>/<name>/.
  if inside_dir "$WORKTREE_ROOT"; then
    local pool_root_real rel key rest name
    pool_root_real=$(cd "$WORKTREE_ROOT" && pwd -P)
    rel="${cwd_real#"$pool_root_real"/}"
    key="${rel%%/*}"
    rest="${rel#*/}"
    name="${rest%%/*}"
    # Bare cwd == pool root (no key) or cwd at $WORKTREE_ROOT/<key> with no slot
    # below: not a worktree context. Fall through to none.
    if [ -n "$key" ] && [ "$rel" != "$key" ] && [ -n "$name" ]; then
      printf 'worktree\t%s\n' "$WORKTREE_ROOT/$key/$name" | sed "s|$HOME|~|"
      return 0
    fi
  fi

  # Source: git toplevel matches some pool's `source:`.
  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || { echo none; return 0; }
  toplevel=$(cd "$toplevel" && pwd -P)

  local cfg key src
  for cfg in "$WORKTREE_ROOT"/*/.meta/config.yaml; do
    [ -f "$cfg" ] || continue
    key=$(basename "$(dirname "$(dirname "$cfg")")")
    src=$(pool_source_path "$key") || continue
    src=$(cd "$src" 2>/dev/null && pwd -P) || continue
    if [ "$src" = "$toplevel" ]; then
      printf 'source\t%s\n' "$toplevel" | sed "s|$HOME|~|"
      return 0
    fi
  done

  echo none
}

# Print the current repo's toplevel path and CLAUDE.md to stdout. Intended for
# AI-agent session bootstrap.
cmd_orient() {
  local repo
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "orient: not inside a git repo"
  printf '%s\n' "$repo"
  if [ -f "$repo/CLAUDE.md" ]; then
    printf '\n'
    cat "$repo/CLAUDE.md"
  fi
}

cmd_ls() {
  # Show only held slots; drop STATE + NAME columns; drop GROUP when uniform
  # across held rows. STATE is constant after the held-only filter, NAME == ID
  # for held slots (renamed at acquire), and GROUP is interesting only when
  # multiple groups have held slots. Use `worktree-pool ls` for the full table.
  local out held
  out=$(worktree-pool --pool "$POOL_KEY" ls "$@")
  held=$(printf '%s\n' "$out" | awk 'NR>2 && $2=="held"')
  if [ -z "$held" ]; then
    echo "(no held slots)"
    return 0
  fi
  local drop_group=0
  [ "$(printf '%s\n' "$held" | awk '{print $4}' | sort -u | wc -l)" -le 1 ] && drop_group=1
  {
    printf '%s\n' "$out" | awk 'NR<=2'
    printf '%s\n' "$held"
  } | awk -v dg="$drop_group" '{$2=""; $3=""; if (dg) $4=""; print}' | column -t
}

# Initialize a pool, inferring --source from cwd's git toplevel and --pool from
# its basename (override via `wt --pool <key> init`). All other flags pass
# through to `worktree-pool init`; `--max-slots` defaults to 16 if omitted.
cmd_init() {
  set -e

  # Refuse from inside any existing pool — `git rev-parse --show-toplevel` would
  # resolve to the slot, not the underlying source repo.
  inside_dir "$WORKTREE_ROOT" \
    && die "init: refusing to run from inside a pool slot — cd into the source repo first."

  local source
  source=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "init: not inside a git repo — cd into the source repo first."
  source=$(cd "$source" && pwd -P)

  local key="${POOL_KEY:-$(basename "$source")}"

  local has_max_slots=0 a
  for a in "$@"; do
    case "$a" in --max-slots|--max-slots=*) has_max_slots=1; break ;; esac
  done
  (( has_max_slots )) || set -- --max-slots 16 "$@"

  exec worktree-pool --pool "$key" init --source "$source" "$@"
}

cmd_info() {
  local name="${1:-}"; shift || true
  require_arg name "$name" "wt info <name>"
  exec worktree-pool --pool "$POOL_KEY" inspect --name "$name" "$@"
}

# ---------- dispatch ----------

POOL_KEY=""
# Parse `--pool <key>` / `-p <key>` anywhere before the verb.
while [ $# -gt 0 ]; do
  case "$1" in
    --pool)   [ $# -ge 2 ] || die "--pool requires an argument"; POOL_KEY="$2"; shift 2 ;;
    --pool=*) POOL_KEY="${1#--pool=}"; shift ;;
    -p)       [ $# -ge 2 ] || die "-p requires an argument"; POOL_KEY="$2"; shift 2 ;;
    *)        break ;;
  esac
done

verb="${1:-}"; shift || true
case "$verb" in
  init)    cmd_init    "$@" ;;
  path)    require_pool; cmd_path    "$@" ;;
  go)      require_pool; cmd_go      "$@" ;;
  land)    cmd_land    "$@" ;;
  cleanup) require_pool; cmd_cleanup "$@" ;;
  rm)      require_pool; cmd_rm      "$@" ;;
  orient)  cmd_orient  "$@" ;;
  whoami)  cmd_whoami  "$@" ;;
  ls)      require_pool; cmd_ls      "$@" ;;
  info)    require_pool; cmd_info    "$@" ;;
  *)       die "usage: ${0##*/} [--pool <key>] {init|path|go|cleanup|rm|ls|info} ... | land [message] | whoami | orient" ;;
esac
