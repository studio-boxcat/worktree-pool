#!/usr/bin/env bash
# worktree-pool-session — convenience wrapper around `worktree-pool` for the
# common dev-session lifecycle: acquire + launch an interactive shell + safe-recycle on exit.
# See https://github.com/studio-boxcat/worktree-pool for the underlying tool.
#
# Usage:
#   worktree-pool-session path <pool-key> <name>        # print slot path; exit 0 if exists, 1 if not, 2 on error
#   worktree-pool-session go <pool-key> <name> [--from <commit-ish>] [pool-acquire-flags...]
#   worktree-pool-session sync [message]                # commit + merge origin/main + publish
#   worktree-pool-session cleanup <pool-key> <name>     # 🟢/🟡/🔴 exit-trap classifier
#   worktree-pool-session rm <pool-key> <name>          # safety-checked release
#   worktree-pool-session orient                        # print current repo path + CLAUDE.md
#
# Slot-scoped verbs (path/go/cleanup/rm) take a pool-key first arg. The git-flow
# verb (sync) takes none — it operates on the current worktree's repo and finds
# the main worktree via `git worktree list`. Each consumer wraps with a thin
# `just` recipe.

set -uo pipefail   # set -e is per-subcommand (cleanup must always exit 0).

# ---------- helpers ----------

die() { echo "${0##*/}: $*" >&2; exit 1; }

require_arg() { [ -n "$2" ] || die "usage: $3"; }

pool_root() { printf '%s/.worktree-pool/%s' "$HOME" "$1"; }

# Echo the name of any in-progress git operation (rebase, merge, cherry-pick,
# revert) for the repo at $1. Empty if clean.
in_progress_marker() {
  local git_dir
  git_dir=$(git -C "$1" rev-parse --git-dir 2>/dev/null || true)
  [ -z "$git_dir" ] && return 0
  local marker
  for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$git_dir/$marker" ]; then
      printf '%s' "$marker"
      return 0
    fi
  done
}

# Echo count of commits in <branch> not in origin/main. '?' on rev-list failure.
# Returns 1 if the branch ref doesn't exist.
ahead_count() {
  local path=$1 branch=$2
  git -C "$path" fetch --quiet origin main 2>/dev/null || true
  git -C "$path" show-ref --quiet --verify "refs/heads/$branch" || return 1
  git -C "$path" rev-list --count "origin/main..$branch" 2>/dev/null || echo '?'
}

# Find the absolute path of the worktree that has refs/heads/main checked out.
# Echoes empty string if no worktree holds main. Pool slots are themselves
# `git worktree`s of source, so from any slot this returns the source path.
find_main_path() {
  git worktree list --porcelain | awk '
    /^worktree /{p=substr($0, 10)}
    /^branch refs\/heads\/main$/{print p; exit}
  '
}

# ---------- subcommands ----------

# Print the absolute slot path for `<pool-key>/<name>`. Always emits the path
# on stdout (when key+pool are valid) so callers that only need exists/not
# can `>/dev/null` it. Exit codes:
#   0 — slot exists at that path (resumable / introspectable)
#   1 — pool exists but slot doesn't (caller would `acquire` to create)
#   2 — usage error or pool not initialized
# Distinct from the predicate exits so callers can branch without parsing.
cmd_path() {
  local key="${1:-}"; shift || true
  local name="${1:-}"; shift || true
  if [ -z "$key" ] || [ -z "$name" ]; then
    echo "usage: ${0##*/} path <pool-key> <name>" >&2
    exit 2
  fi

  local POOL_ROOT
  POOL_ROOT=$(pool_root "$key")
  if [ ! -d "$POOL_ROOT" ]; then
    echo "${0##*/}: pool '$key' not initialized at $POOL_ROOT" >&2
    exit 2
  fi

  local path="$POOL_ROOT/$name"
  printf '%s\n' "$path"
  [ -d "$path" ]
}

cmd_go() {
  set -e
  local key="${1:-}"; shift || true
  local name="${1:-}"; shift || true
  require_arg key  "$key"  "session go <pool-key> <name> [--from <commit-ish>] [pool-flags...]"
  require_arg name "$name" "session go <pool-key> <name> [--from <commit-ish>] [pool-flags...]"

  # Translate `--from <X>` → `--commit <X>` for the underlying acquire.
  local acquire_args=() from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)     [ $# -ge 2 ] || die "--from requires an argument"; from="$2"; shift 2 ;;
      --from=*)   from="${1#--from=}"; shift ;;
      *)          acquire_args+=("$1"); shift ;;
    esac
  done
  # `${arr[@]+...}` form keeps empty-array expansion safe under bash 3.2's `set -u`.
  [ -n "$from" ] && acquire_args=(--commit "$from" ${acquire_args[@]+"${acquire_args[@]}"})

  local POOL_ROOT
  POOL_ROOT=$(pool_root "$key")
  [ -d "$POOL_ROOT" ] || die "pool '$key' not initialized at $POOL_ROOT — run: worktree-pool --pool $key init --source <repo> --max-slots <n> ..."

  # Refuse from inside a pool slot — `pwd -P` resolves symlinks.
  local pool_real cwd_real
  pool_real=$(cd "$POOL_ROOT" && pwd -P)
  cwd_real=$(pwd -P)
  if [[ "$cwd_real" == "$pool_real"/* ]]; then
    die "refusing to nest — already inside a pool slot."
  fi

  # If a slot with this name already exists, resume it instead of acquiring.
  # Warn loudly — `--from` and other acquire flags are ignored on resume
  # (slot stays at its existing commit).
  local path existing=0
  if [ -d "$POOL_ROOT/$name" ]; then
    existing=1
    path="$POOL_ROOT/$name"
    local Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ slot %s/%s already exists — resuming (acquire flags ignored). Use `%s rm %s %s` first to recreate.%s\n' \
      "$Y" "$key" "$name" "${0##*/}" "$key" "$name" "$X" >&2
  else
    path=$(worktree-pool --pool "$key" acquire --name "$name" ${acquire_args[@]+"${acquire_args[@]}"} | tail -1)
    if [[ -z "$path" || ! -d "$path" ]]; then
      die "pool returned no path."
    fi
  fi

  # On exit, run our own cleanup verb. Quoting is conservative for keys/names with shell metachars.
  local self
  self="$0"
  trap "'$self' cleanup '$key' '$name'" EXIT

  printf '\n──── session: %s/%s @ %s ────\n\n' "$key" "$name" "$path"

  local cmd="${WORKTREE_POOL_SESSION_CMD:-ai}"
  [ "$existing" = 1 ] && cmd="$cmd --continue"
  (cd "$path" && exec "${SHELL:-zsh}" -ic "$cmd")
}

cmd_sync() {
  set -e
  local msg="${1:-}"

  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$branch" = "main" ] || [ "$branch" = "HEAD" ]; then
    die "sync: must run from a non-main branch (current: $branch)"
  fi

  local marker
  marker=$(in_progress_marker .)
  if [ -n "$marker" ]; then
    echo "sync: in-progress $marker — finish or abort first." >&2
    echo "After finishing the merge commit, re-run sync." >&2
    exit 1
  fi

  local untracked
  untracked=$(git ls-files --others --exclude-standard)
  if [ -n "$untracked" ]; then
    echo "sync: untracked files — add, ignore, or remove first:" >&2
    printf '%s\n' "$untracked" | sed 's/^/  /' >&2
    exit 1
  fi

  local main_path
  main_path=$(find_main_path)
  [ -n "$main_path" ] || die "sync: main is not checked out in any worktree"

  # `git reset --hard HEAD` only touches tracked files, so untracked content
  # in main survives the post-publish refresh; ignore `??` here.
  local main_dirty
  main_dirty=$(git -C "$main_path" status --porcelain | awk '!/^\?\?/')
  if [ -n "$main_dirty" ]; then
    echo "sync: main worktree ($main_path) has uncommitted tracked changes:" >&2
    printf '%s\n' "$main_dirty" | sed 's/^/  /' >&2
    exit 1
  fi

  # Auto-commit dirty tracked work. Refuse silent WIP commits.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    if [ -z "$msg" ]; then
      echo "sync: dirty tracked work needs a commit message:" >&2
      git status --short >&2
      echo >&2
      echo "  sync \"feat: <what you did>\"" >&2
      echo "  sync wip                          # shorthand → 'WIP via sync'" >&2
      exit 1
    fi
    [ "$msg" = "wip" ] && msg="WIP via sync"
    git add -u
    git commit -m "$msg"
  fi

  # Merge origin/main. On conflict, halt with resume hint. On the resume path
  # (after manual conflict resolution + commit), this is "Already up to date."
  git fetch origin main
  if ! git merge --no-ff -m "Sync main into $branch" origin/main; then
    echo >&2
    echo "sync: merge halted with conflicts. Resolve and either:" >&2
    echo "  • finish: 'git add' the files, 'git commit', then re-run sync" >&2
    echo "  • back out: 'git merge --abort'" >&2
    exit 1
  fi

  # Publish: advance local main, refresh main worktree, atomic push.
  # Re-fetch in case origin/main moved during a long conflict resolution.
  git fetch origin main
  if ! git merge-base --is-ancestor origin/main HEAD; then
    echo "sync: origin/main has moved past your merge base." >&2
    echo "  Re-merge with 'git merge --no-ff origin/main', resolve, commit, then re-run." >&2
    exit 1
  fi

  local expected_main
  expected_main=$(git rev-parse main)
  # Skip the no-op so push-rejected re-runs are idempotent.
  if [ "$expected_main" != "$(git rev-parse HEAD)" ]; then
    git update-ref -m "sync from $branch" refs/heads/main HEAD "$expected_main"
    git -C "$main_path" reset --hard HEAD >/dev/null
  fi

  git push --atomic origin main "$branch"
  echo "sync: $branch published; main + origin/main + origin/$branch at $(git rev-parse --short HEAD)"
}

cmd_cleanup() {
  local key="${1:-}"; shift || true
  local name="${1:-}"; shift || true
  [ -n "$key" ] && [ -n "$name" ] || { echo "usage: cleanup <pool-key> <name>" >&2; exit 0; }

  local POOL_ROOT path
  POOL_ROOT=$(pool_root "$key")
  path="$POOL_ROOT/$name"

  local G Y R X
  if [ -t 1 ]; then
    G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[1;31m'; X=$'\e[0m'
  else
    G=''; Y=''; R=''; X=''
  fi

  if [ ! -d "$path" ]; then
    printf '%s🟢 slot %s/%s already recycled%s\n' "$G" "$key" "$name" "$X"
    exit 0
  fi

  local marker
  marker=$(in_progress_marker "$path")
  if [ -n "$marker" ]; then
    printf '%s🟡 %s: in-progress %s — finish or abort first. NOT recycling.%s\n' \
      "$Y" "$name" "$marker" "$X" >&2
    exit 0
  fi

  local porcelain dirty untrk ahead
  porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
  read -r dirty untrk < <(printf '%s' "$porcelain" | awk 'NF{if(/^\?\?/)u++;else d++} END{print d+0, u+0}')

  ahead=0
  if a=$(ahead_count "$path" "$name"); then ahead="$a"; fi

  if [ "$ahead" != "0" ]; then
    printf '%s🔴 UNMERGED: %s has %s commit(s) not in origin/main — NOT recycling.%s\n' \
      "$R" "$name" "$ahead" "$X" >&2
    printf '   git branch -D %s   # to discard\n' "$name" >&2
    exit 0
  fi
  if [ "$dirty" != "0" ] || [ "$untrk" != "0" ]; then
    printf '%s🟡 dirty: %s — %s modified, %s untracked. NOT recycling.%s\n' \
      "$Y" "$name" "$dirty" "$untrk" "$X" >&2
    exit 0
  fi

  "$0" rm "$key" "$name" || true
  printf '%s🟢 recycled cleanly: %s/%s%s\n' "$G" "$key" "$name" "$X"
}

cmd_rm() {
  set -e
  local key="${1:-}"; shift || true
  local name="${1:-}"; shift || true
  require_arg key  "$key"  "session rm <pool-key> <name>"
  require_arg name "$name" "session rm <pool-key> <name>"

  local POOL_ROOT path
  POOL_ROOT=$(pool_root "$key")
  path="$POOL_ROOT/$name"
  [ -d "$path" ] || die "no slot named '$name' in pool '$key' at $POOL_ROOT."

  local porcelain
  porcelain=$(git -C "$path" status --porcelain 2>/dev/null || true)
  if [ -n "$porcelain" ]; then
    echo "${0##*/}: '$name' is dirty — refusing." >&2
    printf '%s\n' "$porcelain" | sed 's/^/  /' >&2
    exit 1
  fi

  local ahead
  if ahead=$(ahead_count "$path" "$name"); then
    if [ "$ahead" != "0" ]; then
      echo "${0##*/}: '$name' has $ahead commit(s) not in origin/main — refusing." >&2
      echo "  git branch -D $name   # to discard" >&2
      exit 1
    fi
  fi

  worktree-pool --pool "$key" release --name "$name"
}

# Print the current repo's toplevel path and CLAUDE.md to stdout. Intended for
# AI-agent session bootstrap — `orient` answers "where am I and what are the
# rules here." No pool-key argument; resolved from `git rev-parse`.
cmd_orient() {
  local repo
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "orient: not inside a git repo"
  printf '%s\n' "$repo"
  if [ -f "$repo/CLAUDE.md" ]; then
    printf '\n'
    cat "$repo/CLAUDE.md"
  fi
}

# ---------- dispatch ----------

verb="${1:-}"; shift || true
case "$verb" in
  path)    cmd_path    "$@" ;;
  go)      cmd_go      "$@" ;;
  new)
    Y='' X=''
    [ -t 2 ] && { Y=$'\e[33m'; X=$'\e[0m'; }
    printf '%s⚠ `new` is deprecated — use `go` instead.%s\n' "$Y" "$X" >&2
    cmd_go "$@" ;;
  sync)    cmd_sync    "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  rm)      cmd_rm      "$@" ;;
  orient)  cmd_orient  "$@" ;;
  *)       die "usage: ${0##*/} {path|go|cleanup|rm} <pool-key> <name> ... | sync [message] | orient" ;;
esac
